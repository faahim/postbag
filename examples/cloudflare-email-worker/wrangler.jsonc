{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postbag-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Email-only Worker: no fetch handler, so no public workers.dev URL.
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // Set at deploy time: `wrangler deploy --var POSTBAG_SUBMIT_URL:https://postbag.dev/s/fm_…`
    // or copy this file's value into .dev.vars for local runs. Not a secret, but it is
    // deployment-specific, so it is left blank here.
    "POSTBAG_SUBMIT_URL": "",
    // Optional safety net — every email is also forwarded to this verified address:
    // "FORWARD_TO": "you@example.com"
  }
}
