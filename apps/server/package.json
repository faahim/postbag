{
  "name": "@postbag/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && cp src/llms.md dist/llms.md && mkdir -p dist/skills/postbag && cp ../../skills/postbag/SKILL.md dist/skills/postbag/SKILL.md",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@polar-sh/sdk": "0.49.0",
    "@postbag/auth": "workspace:*",
    "@postbag/core": "workspace:*",
    "@postbag/db": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "pino": "10.3.1",
    "resend": "6.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
