    "@hono/zod-openapi": "1.6.1",
    "@postbag/auth": "workspace:*",
    "@postbag/core": "workspace:*",
    "@postbag/db": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "pino": "10.3.1",
    "resend": "6.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
