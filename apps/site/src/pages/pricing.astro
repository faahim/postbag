---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import PricingNotify from "@/components/PricingNotify.astro"
import { GITHUB_URL, PLANS, SIGNUP_URL, SITE_URL } from "@/config"
import { breadcrumbLd, faqLd, softwareLd, webPageLd } from "@/lib/seo"
const crumbs = [ { name: "Home", href: "/" }, { name: "Pricing", href: "/pricing/" } ]
const pro = PLANS.find((p) => p.id === "pro")!
const team = PLANS.find((p) => p.id === "team")!
const faqs = [
  { q: "Is Postbag free?", a: "Yes. The free plan includes 5 forms, 1,000 submissions a month, 5 destinations and 90-day retention, with every feature: streams, schemas, signed webhooks, the full API. Paid plans go on sale when billing ships; leave your email on a plan and you will get one message when it does." },
  { q: "What happens if I go over the submission limit?", a: "Submissions are still stored and flagged over quota; delivery pauses until the plan allows. Nothing is dropped. Test submissions (_test: true) do not count." },
  { q: "Do the paid plans have different features?", a: "No. Plans differ only in limits: forms, submissions per month, destinations and retention. Every plan has the whole product, including the API and agent features. Team adds seats and compliance paperwork, which only make sense on a hosted account." },
  { q: `Why is Pro $${pro.monthly} a month?`, a: "Because it is priced as a routing and delivery service, not as a form-to-email relay. The outbox, signed webhooks, streams and the agent surface are on every plan; the price buys the hosted operation of them: deliverability, retries, retention and support." },
  { q: "Who is the seller, and will I get a proper invoice?", a: "Billing will run through a Merchant of Record, which acts as the seller, charges the correct VAT or sales tax for your country and issues a compliant invoice for every payment." },
  { q: "What does self-hosting cost?", a: "Nothing from us. Postbag is open source: the server is AGPL-3.0 and the client packages (SDK, CLI, MCP server) are MIT. You run the image against your own Postgres with effectively unlimited limits. The repository opens publicly with the first npm release of the client packages." },
]
const fmt = (n: number) => n.toLocaleString("en-US")
const ld = [ softwareLd(), webPageLd({ url: `${SITE_URL}/pricing/`, name: "Postbag pricing", description: `Postbag plans: Free (5 forms, 1,000 submissions/month), Pro $${pro.monthly}/month, Team $${team.monthly}/month, and free open-source self-hosting. Every feature on every plan.` }), breadcrumbLd(crumbs), faqLd(faqs) ]
---
<Base title="Pricing" description={`Postbag pricing: Free with 5 forms and 1,000 submissions a month, Pro at $${pro.monthly}/month, Team at $${team.monthly}/month, every feature on every plan. Self-hosting is free and open source.`} canonical="/pricing/" ld={ld}>
  <PageHeader title="Every feature on every plan. Plans differ only in limits." lede="There is no feature gate in Postbag: streams, schemas, signed webhooks and the agent surface are on the free plan. Paid plans raise the numbers. Billing is being built; paid plans are priced but not yet on sale." crumbs={crumbs} />
  <section class="container-x">
    <div class="grid gap-4 lg:grid-cols-4" data-reveal-group="70">
      {PLANS.map((p) => (
        <div class={`card flex flex-col p-6 ${p.id === "pro" ? "shadow-md ring-1 ring-primary/30" : ""}`} data-reveal>
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-xl font-semibold">{p.name}</h2>
            {p.id === "pro" && <span class="rounded-full bg-accent/60 px-2.5 py-0.5 text-xs font-medium">For many sites</span>}
          </div>
          <p class="mt-1 font-display text-3xl font-semibold tabular">${p.monthly}<span class="text-base font-normal text-muted-foreground">/month</span></p>
          <p class="mt-1 text-sm text-muted-foreground tabular">{p.monthly === 0 ? "Free forever, no card." : `$${p.yearly}/month billed yearly.`}</p>
          <dl class="mt-5 grid flex-1 gap-2 text-[15px]">
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Forms</dt><dd class="tabular">{fmt(p.forms)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Submissions / month</dt><dd class="tabular">{fmt(p.submissions)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Destinations</dt><dd class="tabular">{fmt(p.destinations)}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Retention</dt><dd class="tabular">{p.retention} days</dd></div>
            {p.id === "team" && <div class="flex justify-between gap-4"><dt class="text-muted-foreground">Seats, audit log, DPA</dt><dd>Included</dd></div>}
          </dl>
          {p.id === "free" ? <a href={SIGNUP_URL} class="btn btn-primary mt-6">Create a form</a> : <PricingNotify planId={p.id} planName={p.name} />}
        </div>
      ))}
      <div class="card flex flex-col bg-foreground p-6 text-background" data-reveal>
        <h2 class="text-xl font-semibold text-background">Self-host</h2>
        <p class="mt-1 font-display text-3xl font-semibold">Free</p>
        <p class="mt-1 text-sm text-background/70">Open source, AGPL-3.0.</p>
        <dl class="mt-5 grid flex-1 gap-2 text-[15px] text-background/80">
          <div class="flex justify-between gap-4"><dt>Forms</dt><dd>Unlimited</dd></div>
          <div class="flex justify-between gap-4"><dt>Submissions</dt><dd>Unlimited</dd></div>
          <div class="flex justify-between gap-4"><dt>Destinations</dt><dd>Unlimited</dd></div>
          <div class="flex justify-between gap-4"><dt>Retention</dt><dd>Your policy</dd></div>
        </dl>
        <div class="mt-6 grid gap-2">
          <a href="/docs/self-hosting/" class="btn bg-background/10 text-background hover:bg-background/20">Self-host guide</a>
          <a href={GITHUB_URL} class="text-center text-sm text-background/70 hover:text-background" rel="noopener">Source on GitHub</a>
        </div>
      </div>
    </div>
    <p class="mt-6 max-w-3xl text-[15px] text-muted-foreground">Every plan includes: unlimited projects, streams and routes; email, Telegram and signed webhook destinations; schemas, drift and inference; the full API, llms.txt and OpenAPI; the dashboard. Limits mirror <code class="font-mono text-[0.9em]">GET /v1/me</code>. Prices are in USD; tax is added at checkout where it applies.</p>
  </section>
  <Faq items={faqs} class="mt-20" title="Pricing questions" />
  <CtaBand />
</Base>
