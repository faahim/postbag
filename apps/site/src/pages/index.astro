---
import Base from "@/layouts/Base.astro"
import Hero from "@/components/home/Hero.astro"
import Integration from "@/components/home/Integration.astro"
import Journey from "@/components/home/Journey.astro"
import AgentNative from "@/components/home/AgentNative.astro"
import Operator from "@/components/home/Operator.astro"
import Guarantees from "@/components/home/Guarantees.astro"
import Destinations from "@/components/home/Destinations.astro"
import SelfHost from "@/components/home/SelfHost.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { faqLd, softwareLd, webPageLd } from "@/lib/seo"
import { AGENT_PROMPT, DESCRIPTION, SITE_URL } from "@/config"

const faqs = [
  { q: "What is Postbag?", a: "The open-source form backend built for agents. Point any form at your Postbag address; every message is saved the moment it arrives, then sent where you want it — inbox, Telegram, or a webhook. Your agent can run the whole setup." },
  { q: "What is a form backend?", a: "The part of a contact form you'd rather not build: the place messages actually go. Your site's <code>&lt;form action&gt;</code> points at Postbag; Postbag keeps the message safe and tells you. No server code on your end." },
  { q: "Do I need JavaScript or an SDK?", a: "No. A plain HTML form works as it is, and visitors land back on your page. Prefer fetch or a framework? Postbag hands you ready-made snippets for HTML, fetch, React, Astro and Next.js." },
  { q: "Does Postbag ever lose submissions?", a: "No — this is the hill Postbag lives on. Everything that arrives is saved, spam included, each with a label. Things are deleted only when you delete them, or when your retention window says so." },
  { q: "How is Postbag different from Formspree, Formspark or Getform?", a: "Three things. Every message is saved before it's sent anywhere, with every attempt on the record. A coding agent can do the entire setup before you sign up. And you can run the whole product yourself, free. See the <a href='/compare/'>comparison pages</a>." },
  { q: "Where can Postbag send messages?", a: "Email (replying goes straight to the sender), Telegram, and signed webhooks for everything else — your CRM, your Slack bot, anything with a URL. Native Slack and Discord are next." },
  { q: "Can coding agents like Claude Code or Cursor use Postbag?", a: "Yes — that's the heart of it. An agent can create a form with no account, wire it into your site, and prove it works with test messages. You sign in only to keep the form and turn on real sending." },
  { q: "Can I self-host Postbag?", a: "Yes. One Docker container plus one Postgres database is the entire product — the hosted version is the same code with billing on. There's a compose file to start from and a proper guide." },
  { q: "How much does it cost?", a: "Free gets you 5 forms, 1,000 messages a month and 90 days of history. Pro is $15 a month, Team is $49 — bigger rooms, same product. Self-hosting is free, because it's open source. See <a href='/pricing/'>pricing</a>." },
]
const ld = [
  softwareLd(),
  webPageLd({ url: `${SITE_URL}/`, name: "Postbag: your forms have somewhere to go", description: DESCRIPTION }),
  faqLd(faqs),
]
---
<Base title="Postbag: your forms have somewhere to go" description={DESCRIPTION} canonical="/" ld={ld}>
  <Hero />
  <Integration />
  <Journey />
  <AgentNative />
  <Operator />
  <Guarantees />
  <Destinations />
  <SelfHost />
  <Faq items={faqs} class="mt-28 sm:mt-36" />
  <CtaBand
    title="Give the form job to your agent."
    body="It can build, wire and test the form before you even have an account. Claim it when it's worth keeping."
    primary={{ label: "Copy agent prompt", copyText: AGENT_PROMPT }}
  />
</Base>
