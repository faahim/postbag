---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { COMPETITORS } from "@/content/compare"
import { breadcrumbLd, faqLd, webPageLd } from "@/lib/seo"
import { SITE_URL } from "@/config"
import { ArrowUpRight, CornerDownRight } from "@lucide/astro"

export function getStaticPaths() {
  return COMPETITORS.map((c) => ({ params: { slug: c.slug }, props: { c } }))
}
const { c } = Astro.props
const path = `/compare/${c.slug}/`
const crumbs = [ { name: "Home", href: "/" }, { name: "Compare", href: "/compare/" }, { name: `vs ${c.name}`, href: path } ]
const ld = [ webPageLd({ url: `${SITE_URL}${path}`, name: c.title, description: c.description, modified: c.checked }), breadcrumbLd(crumbs), faqLd(c.faqs) ]
const others = COMPETITORS.filter((o) => o.slug !== c.slug)
---
<Base title={c.title} description={c.description} canonical={path} ld={ld} ogImage="/og/compare.png" modified={c.checked}>
  <PageHeader title={c.title} lede={c.lede} crumbs={crumbs} modified={c.checked} />

  <article class="container-x">
    <section class="compare-verdict" aria-labelledby="verdict-heading" data-reveal>
      <div class="compare-verdict-labels" aria-hidden="true"><span>Postbag</span><i></i><span>{c.name}</span></div>
      <div class="compare-verdict-copy">
        <p class="compare-kicker">The short version</p>
        <h2 id="verdict-heading">Same starting point. Different route after submit.</h2>
        <p>{c.summary}</p>
      </div>
      <div class="compare-verdict-mark" aria-hidden="true"><span></span><i></i><b></b></div>
    </section>

    <section class="compare-table-section mt-20 sm:mt-28" aria-labelledby="evidence-heading">
      <div class="compare-table-heading">
        <div>
          <p class="compare-kicker">The evidence</p>
          <h2 id="evidence-heading">What each service says it does.</h2>
        </div>
        <p>These are not ratings. They are the practical details that tend to matter after a Form is live.</p>
      </div>
      <div class="compare-table-wrap" tabindex="0" role="region" aria-label={`Capability comparison between Postbag and ${c.name}. Scroll horizontally on smaller screens.`}>
        <table>
          <caption>Capability comparison between Postbag and {c.name}</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col" class="compare-postbag-column"><span>Postbag</span></th>
              <th scope="col"><span>{c.name}</span></th>
            </tr>
          </thead>
          <tbody>
            {c.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.postbag}</td>
                <td>{r.them}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare-scroll-note">On a small screen, the table scrolls sideways so the full wording stays readable.</p>
      <p class="compare-sources"><span>Source note</span> {c.name} facts checked on <time datetime={c.checked}>{c.checked}</time> against: {c.sources.map((s, i) => <Fragment>{i > 0 && ", "}<a href={s.href} rel="nofollow noopener">{s.label}</a></Fragment>)}. Prices and quotas change, so check the vendor pages before deciding. Tagline quoted: {c.tagline}.</p>
    </section>

    <section class="compare-choice mt-20 sm:mt-28" aria-labelledby="choice-heading">
      <div class="compare-choice-heading">
        <p class="compare-kicker">The practical choice</p>
        <h2 id="choice-heading">Both can be the right answer.</h2>
      </div>
      <div class="compare-choice-paths">
        <section class="compare-choice-path" data-reveal>
          <p class="compare-path-label"><span aria-hidden="true">A</span> Choose {c.name} if</p>
          <ul>{c.whenThem.map((w) => <li><CornerDownRight size={16} stroke-width={1.8} aria-hidden="true" />{w}</li>)}</ul>
        </section>
        <section class="compare-choice-path compare-choice-path-primary" data-reveal style="--reveal-delay: 110ms">
          <p class="compare-path-label"><span aria-hidden="true">B</span> Choose Postbag if</p>
          <ul>{c.whenUs.map((w) => <li><CornerDownRight size={16} stroke-width={1.8} aria-hidden="true" />{w}</li>)}</ul>
        </section>
      </div>
    </section>

    <section class="compare-difference mt-20 sm:mt-28" aria-labelledby="difference-heading">
      <div class="compare-difference-label">
        <p class="compare-kicker">What Postbag keeps hold of</p>
        <span aria-hidden="true">01</span>
      </div>
      <div class="compare-difference-copy">
        <h2 id="difference-heading">The Submission does not disappear into the notification.</h2>
        <p>Postbag treats a Submission as a database row before anything else and Delivery as an outbox drained by a worker. Every attempt is recorded and retryable, including spam. Streams let many Forms with different field names map onto one versioned Schema and reach one partner or CRM with windows and digests. Every webhook is signed. The same <code>/openapi.json</code> and <code>/llms.txt</code> describe the API an agent uses to create, verify and route a Form without a browser. And it ships as one Docker image plus Postgres, so the hosted product and a self-hosted install are the same thing.</p>
      </div>
    </section>

    <nav aria-label="Other comparisons" class="compare-other mt-20 sm:mt-28">
      <div>
        <p class="compare-kicker">Keep comparing</p>
        <h2>Follow the route that matches your setup.</h2>
      </div>
      <ul>{others.map((o) => <li><a href={`/compare/${o.slug}/`}>Postbag and {o.name}<ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" /></a></li>)}</ul>
    </nav>
  </article>
  <Faq items={c.faqs} class="mt-24" />
  <CtaBand />
</Base>

<style>
  .compare-kicker { margin: 0; color: var(--primary); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.13em; line-height: 1.3; text-transform: uppercase; }
  .compare-verdict { position: relative; display: grid; gap: 2rem; overflow: hidden; padding: 2rem; border-radius: 1rem; color: var(--background); background: var(--foreground); box-shadow: var(--shadow-lg); }
  .compare-verdict::before { position: absolute; right: -8rem; bottom: -12rem; width: 28rem; height: 28rem; border: 1px solid color-mix(in oklch, var(--background) 18%, transparent); border-radius: 999px; box-shadow: 0 0 0 2.6rem color-mix(in oklch, var(--background) 4%, transparent), 0 0 0 calc(2.6rem + 1px) color-mix(in oklch, var(--background) 11%, transparent); content: ""; pointer-events: none; }
  .compare-verdict > * { position: relative; z-index: 1; }
  .compare-verdict-labels { display: flex; align-items: center; gap: 0.6rem; width: fit-content; color: color-mix(in oklch, var(--background) 70%, transparent); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .compare-verdict-labels i { width: 1.6rem; height: 1px; background: var(--primary); }
  .compare-verdict-copy { max-width: 45rem; }
  .compare-verdict .compare-kicker { color: var(--primary); }
  .compare-verdict h2, .compare-table-heading h2, .compare-choice h2, .compare-difference h2, .compare-other h2 { margin: 0.7rem 0 0; font-size: clamp(2rem, 4vw, 3.35rem); font-weight: 600; line-height: 1.02; }
  .compare-verdict h2 { color: var(--background); }
  .compare-verdict-copy > p:not(.compare-kicker) { margin: 1.25rem 0 0; color: color-mix(in oklch, var(--background) 75%, transparent); font-size: 1rem; line-height: 1.7; }
  .compare-verdict-mark { position: relative; width: 9rem; height: 2rem; }
  .compare-verdict-mark::before { position: absolute; top: 50%; right: 0.9rem; left: 0.4rem; height: 1px; background: color-mix(in oklch, var(--background) 36%, transparent); content: ""; }
  .compare-verdict-mark span, .compare-verdict-mark i, .compare-verdict-mark b { position: absolute; display: block; border-radius: 999px; }
  .compare-verdict-mark span { top: calc(50% - 0.38rem); left: 0; width: 0.76rem; height: 0.76rem; background: var(--primary); box-shadow: 0 0 0 0.36rem color-mix(in oklch, var(--primary) 23%, transparent); }
  .compare-verdict-mark i { top: calc(50% - 0.2rem); left: 52%; width: 0.4rem; height: 0.4rem; background: var(--foreground); box-shadow: 0 0 0 1px var(--primary); }
  .compare-verdict-mark b { top: calc(50% - 0.65rem); right: 0; width: 1.3rem; height: 1.3rem; border: 1px solid var(--primary); background: var(--foreground); }
  .compare-table-heading { display: grid; gap: 1rem; align-items: end; margin-bottom: 2rem; }
  .compare-table-heading h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
  .compare-table-heading > p { max-width: 31rem; margin: 0; color: var(--muted-foreground); line-height: 1.65; }
  .compare-table-wrap { overflow-x: auto; border-top: 1px solid var(--border-strong); border-bottom: 1px solid var(--border); scrollbar-color: var(--border-strong) transparent; scrollbar-width: thin; }
  .compare-table-wrap:focus-visible { outline-offset: 4px; }
  .compare-table-wrap table { width: 100%; min-width: 47rem; border-collapse: collapse; font-size: 0.91rem; line-height: 1.56; }
  .compare-table-wrap caption { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .compare-table-wrap th, .compare-table-wrap td { padding: 1rem 1.1rem; text-align: left; vertical-align: top; }
  .compare-table-wrap thead th { position: sticky; top: 0; z-index: 1; border-bottom: 1px solid var(--border-strong); color: var(--muted-foreground); background: var(--background); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .compare-table-wrap thead th:first-child { width: 20%; min-width: 9.5rem; }
  .compare-table-wrap thead th:nth-child(2) { color: var(--primary); }
  .compare-table-wrap tbody tr { transition: background-color var(--duration-quick) var(--ease-smooth-out); }
  .compare-table-wrap tbody tr:hover { background: var(--accent); }
  .compare-table-wrap tbody th { width: 20%; border-bottom: 1px solid var(--border); font-family: var(--font-display); font-weight: 600; line-height: 1.3; }
  .compare-table-wrap tbody td { width: 40%; border-bottom: 1px solid var(--border); }
  .compare-table-wrap tbody td:nth-child(2) { color: var(--foreground); }
  .compare-table-wrap tbody td:last-child { color: var(--muted-foreground); }
  .compare-scroll-note { margin: 0.75rem 0 0; color: var(--muted-foreground); font-size: 0.77rem; line-height: 1.5; }
  .compare-sources { max-width: 58rem; margin: 2rem 0 0; color: var(--muted-foreground); font-size: 0.82rem; line-height: 1.6; }
  .compare-sources > span { display: block; margin-bottom: 0.35rem; color: var(--foreground); font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .compare-sources a { color: var(--foreground); text-decoration: underline; text-decoration-color: color-mix(in oklch, var(--primary) 42%, transparent); text-underline-offset: 0.18em; transition: text-decoration-color var(--duration-quick) var(--ease-smooth-out); }
  .compare-sources a:hover { text-decoration-color: var(--primary); }
  .compare-choice { padding-top: 2rem; border-top: 1px solid var(--border-strong); }
  .compare-choice h2 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); }
  .compare-choice-paths { display: grid; gap: 0; margin-top: 2.5rem; border-top: 1px solid var(--border); }
  .compare-choice-path { padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .compare-path-label { display: flex; align-items: center; gap: 0.65rem; margin: 0; font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }
  .compare-path-label span { display: grid; place-items: center; width: 1.55rem; height: 1.55rem; border: 1px solid var(--border-strong); border-radius: 999px; color: var(--muted-foreground); font-family: var(--font-mono); font-size: 0.65rem; }
  .compare-choice-path-primary .compare-path-label span { border-color: var(--primary); color: var(--primary); }
  .compare-choice-path ul { display: grid; gap: 0.75rem; padding: 0; margin: 1.25rem 0 0; list-style: none; }
  .compare-choice-path li { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; max-width: 34rem; color: var(--muted-foreground); font-size: 0.92rem; line-height: 1.55; }
  .compare-choice-path li :global(svg) { margin-top: 0.16rem; color: var(--primary); }
  .compare-difference { display: grid; gap: 1.5rem; padding: 2rem 0; border-top: 1px solid var(--border-strong); border-bottom: 1px solid var(--border); }
  .compare-difference-label { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .compare-difference-label > span { color: var(--border-strong); font-family: var(--font-display); font-size: 4.5rem; font-weight: 600; line-height: 0.76; letter-spacing: -0.07em; }
  .compare-difference h2 { font-size: clamp(1.85rem, 3.3vw, 2.8rem); }
  .compare-difference-copy { max-width: 46rem; }
  .compare-difference-copy > p { margin: 1.25rem 0 0; color: var(--muted-foreground); font-size: 1rem; line-height: 1.72; }
  .compare-difference code { border-radius: 0.25rem; background: var(--surface-2); padding: 0.12em 0.35em; color: var(--foreground); font-family: var(--font-mono); font-size: 0.86em; }
  .compare-other { display: grid; gap: 2rem; padding-bottom: 0.25rem; }
  .compare-other h2 { max-width: 23rem; font-size: clamp(1.65rem, 2.7vw, 2.2rem); }
  .compare-other ul { display: grid; padding: 0; margin: 0; list-style: none; border-top: 1px solid var(--border); }
  .compare-other li { border-bottom: 1px solid var(--border); }
  .compare-other a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.95rem 0; color: var(--foreground); font-size: 0.92rem; text-decoration: none; transition: color var(--duration-quick) var(--ease-smooth-out), padding-left var(--duration-fast) var(--ease-smooth-out); }
  .compare-other a:hover { padding-left: 0.35rem; color: var(--primary); }
  .compare-other a :global(svg) { flex: none; transition: transform var(--duration-fast) var(--ease-smooth-out); }
  .compare-other a:hover :global(svg) { transform: translate(2px, -2px); }
  @media (min-width: 720px) {
    .compare-verdict { grid-template-columns: minmax(0, 1fr) auto; gap: 2.5rem; padding: 3rem; }
    .compare-verdict-labels { grid-column: 1 / -1; }
    .compare-verdict-mark { align-self: end; justify-self: end; }
    .compare-table-heading { grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.62fr); gap: 3rem; }
    .compare-scroll-note { display: none; }
    .compare-choice { display: grid; grid-template-columns: minmax(12rem, 0.72fr) minmax(0, 1.28fr); gap: 3rem; }
    .compare-choice-paths { margin-top: 0; }
    .compare-choice-path { display: grid; grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.2fr); gap: 2rem; align-items: start; }
    .compare-choice-path ul { margin-top: 0; }
    .compare-difference { grid-template-columns: minmax(11rem, 0.6fr) minmax(0, 1.4fr); gap: 4rem; padding: 3rem 0; }
    .compare-difference-label { display: block; }
    .compare-difference-label > span { display: block; margin-top: 2.25rem; }
    .compare-other { grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.3fr); gap: 4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .compare-table-wrap tbody tr, .compare-sources a, .compare-other a, .compare-other a :global(svg) { transition: none; }
    .compare-other a:hover { padding-left: 0; }
    .compare-other a:hover :global(svg) { transform: none; }
  }
</style>
