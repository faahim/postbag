---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CtaBand from "@/components/CtaBand.astro"
import { breadcrumbLd, webPageLd } from "@/lib/seo"
import { SITE_URL } from "@/config"
const crumbs = [ { name: "Home", href: "/" }, { name: "Glossary", href: "/glossary/" } ]
const terms = [
  { t: "Form backend", d: "A service that receives HTML Form Submissions so the website needs no server code of its own. Postbag also stores and routes them." },
  { t: "Organization", label: "Workspace", d: "The tenant. It owns Projects, Forms, Streams, Destinations, Routes and API keys. Every tenant row carries an organization_id." },
  { t: "Project", d: "A folder that keeps Forms understandable for people. A client, a site or a product can each be a Project. Routing is handled by Routes, not Projects." },
  { t: "Form", d: "The thing a website posts to. Its public prefixed id appears in the stable submit URL. Settings cover origins, redirects, honeypots, rate limits, Turnstile and Schema mode." },
  { t: "Submission", d: "One received payload. It keeps submitted data, status, spam signals, request metadata and the Schema version used to validate it." },
  { t: "Form Schema", label: "Fields", d: "A versioned, immutable declaration of what a Form collects. Publishing a change creates a new version." },
  { t: "Schema mode", d: "Observe accepts data and detects Drift; enforce validates and quarantines violations; managed lets Postbag own and serve the Schema." },
  { t: "Stream", label: "Stream", d: "A named group of Forms with one shared, versioned output shape. It lets many Forms feed the same downstream contract." },
  { t: "Stream Schema", label: "What gets delivered", d: "The immutable outbound contract shared by a Stream. A new version revalidates every Mapping." },
  { t: "Mapping", label: "Match fields", d: "The assignment from Form fields to Stream fields. It determines the Delivery payload; values it does not use remain on the original Submission. A Mapping is either valid or incomplete." },
  { t: "Destination", d: "Somewhere Submissions can be sent, such as email, Telegram or a webhook. Add a secret when the receiver should verify its HMAC signature. A Destination belongs to the Organization and can be reused." },
  { t: "Route", label: "Send to", d: "The connection from a Form or Stream to a Destination, with mode, timing, quality rules and an enabled state." },
  { t: "Delivery", d: "One attempt-tracked send of one Submission through one Route. It keeps its payload snapshot, status, attempts, last error and provider response." },
  { t: "Digest", d: "For a digest Route, one Delivery that groups a period's Submissions. It is unique for that Route and period." },
  { t: "Drift", label: "Change detected", d: "A difference between what a Form receives and its declared Schema, such as a new field, missing field or type change." },
  { t: "Outbox", d: "The pattern that writes pending Delivery work in the same transaction as the Submission, then lets a worker drain it safely." },
  { t: "Quarantine", d: "A stored Submission state for outcomes that should not deliver by default, including Schema violations, rejected origins and over-quota traffic." },
  { t: "Agent-native", d: "A property of the whole product: an agent can discover, create, wire, test and manage Forms through the same public contract used by every other client." },
]
const slug = (value: string) => value.toLowerCase().replaceAll(/[^a-z0-9]+/gu, "-")
const description = "The fixed Postbag vocabulary for Forms, Submissions, Streams, Schemas, Mappings, Destinations, Routes, Deliveries and Drift."
const ld = [webPageLd({ url: `${SITE_URL}/glossary/`, name: "Postbag glossary", description }),breadcrumbLd(crumbs),{ "@type": "DefinedTermSet", "@id": `${SITE_URL}/glossary/#terms`, name: "Postbag vocabulary", hasDefinedTerm: terms.map((x) => ({ "@type": "DefinedTerm", name: x.t, description: x.d, inDefinedTermSet: `${SITE_URL}/glossary/#terms` })) }]
---
<Base title="Glossary: the Postbag vocabulary" description={description} canonical="/glossary/" ld={ld} ogImage="/og/docs.png">
  <PageHeader eyebrow="Fixed vocabulary" title="One word per concept." lede="The API uses the engineering word. The dashboard may show a friendlier label, but the underlying concept stays the same everywhere." crumbs={crumbs} />
  <section class="container-x glossary-shell" aria-labelledby="term-index-heading">
    <aside class="term-index" data-reveal><p id="term-index-heading">Jump to</p><nav aria-label="Glossary terms">{terms.map((term) => <a href={`#${slug(term.t)}`}>{term.t}</a>)}</nav></aside>
    <dl id="terms" class="terms">
      {terms.map((term, index) => (
        <div id={slug(term.t)} class="term" data-reveal style={`--reveal-delay: calc(var(--duration-quick) * ${Math.min((index % 4) * 0.3, 0.9)})`}>
          <dt><span>{term.t}</span>{term.label && <small>In the dashboard: {term.label}</small>}</dt><dd>{term.d}</dd>
        </div>
      ))}
    </dl>
  </section>
  <section class="container-x avoid" aria-labelledby="avoid-heading" data-reveal><p>Vocabulary boundary</p><h2 id="avoid-heading">A few words stay outside.</h2><p>Postbag does not use <strong>endpoint</strong> as a noun for Form, or use <strong>integration</strong>, <strong>channel</strong> or <strong>hook</strong> for Destination. It does not rename a Submission as an entry or response. One concept gets one name.</p></section>
  <CtaBand />
</Base>
<style>
  .glossary-shell{display:grid;gap:3rem;padding-top:2rem}.term-index{align-self:start;padding:1.25rem;border-radius:calc(var(--radius) + 8px);background:var(--surface);box-shadow:var(--shadow-sm)}.term-index>p,.avoid>p:first-child{font-family:var(--font-mono);font-size:.68rem;font-weight:650;letter-spacing:.11em;text-transform:uppercase;color:var(--primary)}.term-index nav{display:flex;flex-wrap:wrap;gap:.3rem .8rem;margin-top:1rem}.term-index a{display:inline-flex;align-items:center;min-height:2.5rem;color:var(--muted-foreground);font-size:.84rem;transition:color var(--duration-quick) var(--ease-smooth-out)}.term-index a:hover{color:var(--foreground)}.terms{display:grid}.term{scroll-margin-top:6rem;padding:1.6rem 0;border-top:1px solid var(--border-strong)}dt{display:flex;flex-direction:column;gap:.35rem;font-family:var(--font-display);font-size:1.35rem;font-weight:600}dt small{font-family:var(--font-mono);font-size:.66rem;font-weight:500;letter-spacing:.04em;color:var(--primary)}dd{margin-top:.65rem;color:var(--muted-foreground);font-size:.97rem;line-height:1.7}.avoid{margin-top:5rem;padding-block:3rem;border-block:1px solid var(--border-strong)}.avoid h2{margin-top:.7rem;font-size:clamp(2rem,4vw,3rem);font-weight:600}.avoid>p:last-child{max-width:48rem;margin-top:1rem;color:var(--muted-foreground);line-height:1.75}@media(min-width:48rem){.glossary-shell{grid-template-columns:14rem minmax(0,1fr);gap:clamp(3rem,8vw,7rem)}.term-index{position:sticky;top:6rem}.term-index nav{display:grid;gap:0}.term-index a{min-height:2rem}.term{display:grid;grid-template-columns:minmax(10rem,.65fr) minmax(0,1.35fr);gap:2rem;align-items:start;padding:2rem 0}dd{margin-top:0}}@media(prefers-reduced-motion:reduce){.term-index a{transition-duration:1ms}}
</style>
