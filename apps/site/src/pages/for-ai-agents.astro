---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CodeBlock from "@/components/CodeBlock.astro"
import AgentPromptSwitcher from "@/components/AgentPromptSwitcher.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { API_URL, EXAMPLE, LLMS_URL, OPENAPI_URL, SITE_URL } from "@/config"
import { breadcrumbLd, faqLd, webPageLd } from "@/lib/seo"
const crumbs = [ { name: "Home", href: "/" }, { name: "For AI agents", href: "/for-ai-agents/" } ]
const title = "Postbag for AI agents: create a working Form before signup"
const description = "An agent can create and test a bounded sandbox Form without credentials, keep its stable submit URL through claim, then add a Destination and Route for outbound Delivery."
const faqs = [
  { q: "What does an agent need to start?", a: "No account or API key. <code>POST /v1/public/sandboxes</code> creates a bounded 24-hour sandbox Form with a stable submit URL. The agent can wire it into the site and verify up to five stored test Submissions." },
  { q: "How does the sandbox capability work?", a: "The capability token appears only in the create response. It is not shown again, so the agent must store it safely. The same token can read the sandbox and authorize claim until the Form is claimed or expires." },
  { q: "Can a sandbox send email or webhooks?", a: "No. Before claim it cannot create Destinations, Routes or outbound Deliveries. Claiming preserves the Form id and submit URL. A Destination and Route must then be configured before new Submissions can deliver. Sandbox tests never deliver retroactively." },
  { q: "How does an agent get a full API key?", a: "Email-code authentication uses two calls with one human step between them. The user passes the emailed code to the agent, and verification returns a <code>pb_live_…</code> key. <code>postbag login</code> runs the same flow. Browser OAuth may also be available when the Postbag instance has a provider configured." },
  { q: "How does an agent prove the Form works?", a: "Before claim, it posts to the stable submit URL and reads the stored test with the sandbox capability. After claim, Destination and Route setup, a new <code>_test</code> Submission returns Delivery ids the agent can poll until <code>sent</code>." },
  { q: "Which clients are available?", a: "The TypeScript SDK, <code>postbag</code> CLI and <code>@postbag/mcp</code> server are published on npm. They are thin clients over the same public <code>/v1</code> contract described by <code>/openapi.json</code>." },
  { q: "Can setup be safely retried?", a: "Every POST under <code>/v1</code> accepts an <code>Idempotency-Key</code>. Creates also accept <code>if_exists: \"return\"</code>, so a repeated setup can return the existing object instead of making a duplicate." },
]
const createFlow = `$ key=$(node -e 'console.log(crypto.randomUUID())')
$ curl -X POST ${API_URL}/v1/public/sandboxes \\
  -H "content-type: application/json" \\
  -H "Idempotency-Key: $key" \\
  -d '{"name":"Contact","origin":"https://example.com"}'
# stable submit_url, sandbox_token, embed, claim_url and next[]

$ curl -X POST ${API_URL}/s/${EXAMPLE.form} \\
  -H "content-type: application/json" \\
  -d '{"email":"agent@example.com","message":"test"}'

$ curl ${API_URL}/v1/public/sandboxes/${EXAMPLE.form} \\
  -H "Authorization: Sandbox pbs_…"`
const claimFlow = `$ postbag login
# the human reads the emailed code and gives it to the agent

$ postbag sandbox claim --token pbs_…
# same Form id and submit URL

# create a Destination and Route for the claimed Form
$ postbag destinations create …
$ postbag routes create …

# submit a new test and poll the returned Delivery id
$ postbag deliveries get ${EXAMPLE.delivery}`
const contractSnippet = `# AGENTS.md
Forms on this site post to Postbag.
Read postbag.json for form_id, submit_url and project.

When changing a Form:
1. Use the returned submit URL. Never construct one.
2. Send a _test Submission.
3. Poll its Delivery until sent.
4. Keep API keys and sandbox capabilities out of the repo.`
const agentProperties = [
  ["Discoverable", "llms.txt, OpenAPI and literal next calls tell an agent where to begin and what to do after every create."],
  ["Verifiable", "Receipt and Delivery are separate proofs. The agent can inspect both instead of assuming a 200 means the work is done."],
  ["Safe to repeat", "Idempotency keys and if_exists keep retries boring, which is exactly what setup automation needs."],
  ["Complete", "The SDK, CLI, MCP server and raw HTTP contract reach the same product capabilities as the dashboard."],
]
const ld = [ webPageLd({ url: `${SITE_URL}/for-ai-agents/`, name: title, description }), breadcrumbLd(crumbs), faqLd(faqs) ]
---
<Base title="For AI agents" description={description} canonical="/for-ai-agents/" ld={ld} ogImage="/og/agents.png">
  <PageHeader eyebrow="Agent-native by design" title="Give your agent the form job." lede="It can create, wire and test a real Form before you sign up. You claim the same Form when you are ready, then the agent adds a Destination and Route for Delivery." crumbs={crumbs}>
    <div class="header-actions"><a href={LLMS_URL} class="btn btn-primary">Read llms.txt</a><a href={OPENAPI_URL} class="btn btn-secondary">OpenAPI contract</a><a href="/docs/agents/" class="btn btn-ghost">Agent guide</a></div>
  </PageHeader>

  <section class="container-x handoff" aria-labelledby="handoff-heading">
    <div class="handoff-copy" data-reveal><p class="section-label">One instruction</p><h2 id="handoff-heading">Hand it over without writing a setup guide.</h2><p>Copy the prompt into your coding agent. The Postbag skill gives it the contract and the safe order of operations.</p></div>
    <div class="prompt-surface" data-reveal style="--reveal-delay: var(--duration-quick)"><AgentPromptSwitcher /></div>
  </section>

  <section class="agent-run" aria-labelledby="run-heading">
    <div class="container-x">
      <div class="run-heading" data-reveal><p class="section-label">The working handoff</p><h2 id="run-heading">No credentials to routed Delivery.</h2><p>The Form keeps one identity throughout. What changes is the authority around it.</p></div>
      <ol class="run-track">
        <li data-reveal><span class="run-index">01</span><div><p>Anonymous</p><h3>Create</h3><span>No account</span></div></li>
        <li data-reveal style="--reveal-delay: calc(var(--duration-quick) * .4)"><span class="run-index">02</span><div><p>Sandbox</p><h3>Prove receipt</h3><span>Up to five tests</span></div></li>
        <li data-reveal style="--reveal-delay: calc(var(--duration-quick) * .8)"><span class="run-index">03</span><div><p>Human boundary</p><h3>Claim</h3><span>Same Form id</span></div></li>
        <li data-reveal style="--reveal-delay: calc(var(--duration-quick) * 1.2)"><span class="run-index">04</span><div><p>Organization</p><h3>Route</h3><span>New Deliveries</span></div></li>
      </ol>
    </div>
  </section>

  <section class="container-x code-pair" aria-label="Anonymous create and claim examples">
    <article data-reveal><div class="code-copy"><p class="section-label">Before signup</p><h2>Create and prove receipt.</h2><p>The create response is the only place the sandbox capability appears. Keep it until claim or expiry.</p></div><CodeBlock code={createFlow} lang="bash" title="create → submit → inspect" dense /></article>
    <article data-reveal><div class="code-copy"><p class="section-label">After the human step</p><h2>Claim, connect, deliver.</h2><p>Claim keeps the Form stable. Outbound Delivery starts only after the agent adds a Destination and Route.</p></div><CodeBlock code={claimFlow} lang="bash" title="authenticate → claim → route" dense /></article>
  </section>

  <section class="container-x properties" aria-labelledby="properties-heading">
    <div data-reveal><p class="section-label">Not an AI add-on</p><h2 id="properties-heading">Agent-native is a product property.</h2></div>
    <dl>{agentProperties.map(([term, detail], index) => <div data-reveal style={`--reveal-delay: ${index * 50}ms`}><dt>{term}</dt><dd>{detail}</dd></div>)}</dl>
  </section>

  <section class="container-x repo-memory" aria-labelledby="memory-heading">
    <div data-reveal><p class="section-label">Leave a clean trail</p><h2 id="memory-heading">The next agent should not have to guess.</h2><p>Keep public Form wiring in <code>postbag.json</code> and a short note in the repository instructions. Keep secrets somewhere else.</p></div>
    <div class="memory-code" data-reveal style="--reveal-delay: var(--duration-quick)"><CodeBlock code={contractSnippet} lang="markdown" title="AGENTS.md" /></div>
  </section>
  <Faq items={faqs} class="mt-24" title="Agent questions" />
  <CtaBand title="Let your agent start." body="It can leave a working, tested Form behind. You only step in when it is time to claim and deliver." secondary={{ href: "/docs/agents/", label: "Read the agent guide" }} />
</Base>

<style>
  .header-actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.5rem}.section-label{font-family:var(--font-mono);font-size:.7rem;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--primary)}h2{font-size:clamp(2rem,4vw,3.4rem);font-weight:600;line-height:1.02}.handoff{display:grid;gap:2.5rem;align-items:center;padding-block:3rem 7rem}.handoff-copy{max-width:31rem}.handoff-copy h2,.run-heading h2,.code-copy h2,.properties h2,.repo-memory h2{margin-top:.8rem}.handoff-copy>p:last-child,.run-heading>p:last-child,.code-copy>p:last-child,.repo-memory>div>p:last-child{margin-top:1.1rem;color:var(--muted-foreground);font-size:1.02rem;line-height:1.7}.prompt-surface{padding:clamp(1rem,3vw,1.5rem);border-radius:calc(var(--radius) + 12px);background:var(--surface);box-shadow:var(--shadow-lg)}
  .agent-run{padding-block:6rem;background:var(--foreground);color:var(--background)}.run-heading{max-width:39rem}.agent-run .section-label{color:var(--primary)}.run-heading>p:last-child{color:var(--muted)}.run-track{position:relative;display:grid;gap:1rem;margin-top:3rem}.run-track:before{content:"";position:absolute;left:1.15rem;top:2rem;bottom:2rem;width:1px;background:linear-gradient(var(--primary),var(--border-strong))}.run-track li{position:relative;display:grid;grid-template-columns:2.3rem 1fr;gap:1rem}.run-index{z-index:1;display:grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:50%;background:var(--foreground);box-shadow:0 0 0 1px var(--primary);color:var(--primary);font-family:var(--font-mono);font-size:.67rem}.run-track li>div{padding:1.2rem 1.35rem;border-radius:calc(var(--radius) + 8px);background:var(--surface);color:var(--foreground);box-shadow:var(--shadow-md)}.run-track li p{font-family:var(--font-mono);font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--primary)}.run-track h3{margin-top:.35rem;font-size:1.35rem;font-weight:600}.run-track li div span{display:block;margin-top:.45rem;color:var(--muted-foreground);font-size:.82rem}
  .code-pair{display:grid;gap:5rem;padding-block:7rem}.code-pair article{display:grid;gap:2rem;align-items:start}.code-copy{max-width:29rem}.properties{display:grid;gap:3rem;padding-block:5rem;border-block:1px solid var(--border-strong)}.properties>div{max-width:31rem}.properties dl{display:grid}.properties dl div{display:grid;gap:.55rem;padding:1.25rem 0;border-top:1px solid var(--border-strong)}.properties dt{font-family:var(--font-display);font-size:1.2rem;font-weight:600}.properties dd{color:var(--muted-foreground);line-height:1.65}.repo-memory{display:grid;gap:3rem;align-items:center;padding-block:7rem}.repo-memory>div:first-child{max-width:32rem}.repo-memory code{font-family:var(--font-mono);font-size:.9em}.memory-code{min-width:0}
  @media(min-width:52rem){.handoff,.repo-memory{grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(4rem,8vw,8rem)}.run-track{grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.run-track:before{left:8%;right:8%;top:1.15rem;bottom:auto;width:auto;height:1px}.run-track li{grid-template-columns:1fr;justify-items:center;text-align:center}.run-track li>div{width:calc(100% - 1rem);min-height:9rem;padding-top:2rem}.code-pair article{grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:clamp(3rem,7vw,7rem)}.properties{grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(4rem,8vw,8rem)}.properties dl div{grid-template-columns:9rem 1fr;gap:1.5rem}}
</style>
