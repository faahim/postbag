---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CodeBlock from "@/components/CodeBlock.astro"
import AgentPromptSwitcher from "@/components/AgentPromptSwitcher.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { API_URL, EXAMPLE, LLMS_URL, OPENAPI_URL, SITE_URL } from "@/config"
import { breadcrumbLd, faqLd, webPageLd } from "@/lib/seo"

const crumbs = [ { name: "Home", href: "/" }, { name: "For AI agents", href: "/for-ai-agents/" } ]
const title = "Postbag for AI agents: start a real Form before signup"
const description = "Create and test a bounded sandbox Form without credentials, claim it after a human authenticates, then add Destinations and Routes without changing its submit URL."
const faqs = [
  { q: "What does an AI agent need to start?", a: "Nothing — not even an API key. <code>POST /v1/public/sandboxes</code> returns a stable submit URL and one-time capability token for a bounded 24-hour Form. The agent can wire it into the site and verify up to five stored test Submissions before asking the user to authenticate and claim it." },
  { q: "Can an anonymous sandbox send email or webhooks?", a: "No. It cannot create Destinations, Routes, Deliveries, Events or outbound traffic. Claiming keeps the Form id and submit URL and copies the existing rows as tests, but those tests never deliver retroactively. Only new Submissions after claim and Route setup can deliver." },
  { q: "How does an agent get an API key without a browser?", a: "Two calls, one human step in between: <code>POST /v1/auth/request-code {\"email\":\"…\"}</code> emails a 6-digit code good for 10 minutes; the human gives it to the agent; <code>POST /v1/auth/verify-code {\"email\":\"…\",\"code\":\"…\",\"key_name\":\"site setup\"}</code> returns a <code>pb_live_…</code> key. API key names are 1–32 characters. <code>postbag login</code> drives the same flow." },
  { q: "How does an agent verify that a form actually works?", a: "Before claim, it posts to the stable submit URL and reads the stored test back with <code>GET /v1/public/sandboxes/{id}</code> plus the Sandbox capability. After claim and Route setup, a new <code>_test</code> Submission returns delivery ids to poll until <code>sent</code>." },
  { q: "Is there an MCP server or CLI?", a: "Yes, both are on npm: <code>npx postbag login</code> then <code>npx postbag init</code> for the CLI, and <code>npx -y @postbag/mcp</code> for the MCP server (one tool per API operation, plus <code>postbag_quickstart</code> and <code>postbag_explain</code>). Both are thin clients over the same <code>/v1</code> API, which is small and fully described by <code>/openapi.json</code> — nothing they do is impossible over HTTP." },
  { q: "What happens when an agent makes a mistake?", a: "Every error is <code>{ code, message, hint, docs }</code>. The hint says what to do next; docs is a deep link into <a href='/docs/errors/'>the error reference</a>. Validation errors list the offending fields. Incomplete stream mappings fail at attach time with the missing fields listed." },
  { q: "Is it safe for an agent to re-run a setup script?", a: "Yes. <code>Idempotency-Key</code> is honoured on every POST under /v1, and creates accept <code>if_exists: \"return\"</code> so re-running returns the same objects instead of duplicates or errors." },
  { q: "How should a site repo remember its Postbag wiring?", a: "The convention is a <code>postbag.json</code> at the repo root with <code>form_id</code>, <code>submit_url</code> and <code>project</code>, and a line in CLAUDE.md or AGENTS.md saying forms on this site post to Postbag. Later sessions, human or agent, find the wiring there." },
]

const sandboxFlow = `$ key=$(node -e 'console.log(crypto.randomUUID())')
$ curl -X POST ${API_URL}/v1/public/sandboxes \\
  -H "content-type: application/json" -H "Idempotency-Key: $key" \\
  -d '{"name":"Contact","origin":"https://example.com"}'
# → stable submit_url, sandbox_token, embed, verify, claim_url and next[]

$ curl -X POST ${API_URL}/s/fm_… -H "content-type: application/json" \\
  -d '{"email":"agent@example.com","message":"test"}'
$ curl ${API_URL}/v1/public/sandboxes/fm_… \\
  -H "Authorization: Sandbox pbs_…"`
const keyFlow = `$ curl -X POST ${API_URL}/v1/auth/request-code -d '{"email":"you@example.com"}'
{ "ok": true, "expires_in": 600, "next": "POST /v1/auth/verify-code with { email, code, key_name }" }

# a human reads the 6-digit code out of their inbox and gives it to the agent

$ curl -X POST ${API_URL}/v1/auth/verify-code -d '{"email":"you@example.com","code":"482913","key_name":"site setup"}'
{ "api_key": "pb_live_…", "organization": { "id": "org_…", "slug": "…", "name": "…" },
  "user": { "email": "you@example.com", "created": true },
  "next": [ "Store api_key securely", "POST /v1/quickstart …", "GET /v1/me …" ] }

$ curl -X POST ${API_URL}/v1/sandboxes/fm_…/claim \\
  -H "Authorization: Bearer pb_live_…" -H "Postbag-Sandbox-Token: pbs_…"`
const ld = [ webPageLd({ url: `${SITE_URL}/for-ai-agents/`, name: title, description }), breadcrumbLd(crumbs), faqLd(faqs) ]

const steps = [
  { n: "Create", body: "POST /v1/public/sandboxes needs no credentials. It returns a stable submit URL, framework embeds, a one-time capability token, a browser claim URL and literal next calls. Keep the token and idempotency key secret.", code: `curl -X POST ${API_URL}/v1/public/sandboxes -H "content-type: application/json" -H "Idempotency-Key: <random-uuidv4>" -d '{"name":"Portfolio contact","origin":"https://example.com"}'` },
  { n: "Prove receipt", body: "Wire the returned submit URL, post a test, then read it with Authorization: Sandbox. The 24-hour sandbox stores at most five tests and cannot send anything outbound.", code: `curl -X POST ${API_URL}/s/${EXAMPLE.form} -H "content-type: application/json" -d '{"email":"agent@example.com","message":"test"}'\n\ncurl ${API_URL}/v1/public/sandboxes/${EXAMPLE.form} -H "Authorization: Sandbox pbs_…"` },
  { n: "Claim", body: "Use email-code authentication or let the user open the claim URL and sign in. Claiming requires both authenticated organization access and the sandbox token; it keeps the Form id and submit URL.", code: `postbag login\npostbag sandbox claim --token pbs_…\n# or open /app/claim#token=pbs_… and sign in` },
  { n: "Route", body: "Create a Destination and Route, then post a new real Submission and poll its Delivery. Copied sandbox tests never deliver retroactively.", code: `curl -X POST ${API_URL}/v1/destinations -H "Authorization: Bearer pb_live_…" -d '{\n  "type":"webhook", "name":"CRM", "config":{"url":"https://crm.example.com/hooks/postbag","secret":"…"}\n}'\n# POST /v1/routes for the claimed Form, then submit and poll GET /v1/deliveries/${EXAMPLE.delivery}` },
]
const principles = [
  { t: "Discoverable", b: "llms.txt, openapi.json, and /v1/me. Accept: text/markdown on the site root returns the agent onboarding page." },
  { t: "Finish first, claim after", b: "A bounded sandbox proves durable receipt without credentials. Human authentication transfers the same Form into an organization without changing its submit URL." },
  { t: "Verifiable", b: "_test submissions return delivery ids to poll. Destinations have a /test endpoint that returns the provider's response." },
  { t: "Schema-aware, fleet-aware", b: "GET /v1/streams/{id} returns the stream schema and a form template; POST /v1/forms with from_template creates a form that is pre-attached with a valid mapping. An agent cannot produce a form the stream does not understand." },
  { t: "Idempotent and safe to retry", b: "Idempotency-Key on every POST. if_exists: \"return\" on creates. Re-running setup is a no-op, not a mess." },
  { t: "Errors that teach", b: "{ code, message, hint, docs } on every error; next[] on every create. Ids are prefixed so they are self-describing in logs and conversation." },
]
const snippet = `# CLAUDE.md / AGENTS.md (site repo)
Forms on this site post to Postbag. Config lives in postbag.json (form_id, submit_url, project).
To add a form: POST ${API_URL}/v1/forms with the project slug, then use the embed from the response.
Never hand-write a submit URL. Verify with a _test submission and poll the delivery.`
---
<Base title="For AI agents" description={description} canonical="/for-ai-agents/" ld={ld} ogImage="/og/agents.png">
  <PageHeader title="Built for the agents that build websites." lede="An agent can create and test the real Form before asking the user to sign up. Human authentication claims the same submit URL; only then does outbound delivery unlock." crumbs={crumbs}>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={LLMS_URL} class="btn btn-primary">Read llms.txt</a>
      <a href={OPENAPI_URL} class="btn btn-secondary">openapi.json</a>
      <a href="/docs/agents/" class="btn btn-secondary">Agent guide</a>
    </div>
  </PageHeader>

  <section class="container-x" aria-labelledby="setup-heading">
    <h2 id="setup-heading" class="text-3xl font-semibold text-balance sm:text-4xl">Set up your agent in seconds.</h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted-foreground">Paste the prompt, or pick the skill, MCP server or CLI, none of them a dashboard.</p>
    <div class="mt-10 max-w-2xl" data-reveal>
      <AgentPromptSwitcher />
    </div>
    <div class="mt-12 grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-12" data-reveal>
      <div>
        <h3 class="font-display text-xl font-semibold">Start before login</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">Create a bounded sandbox, wire its final submit URL and prove receipt. It stores tests but cannot deliver or configure tenant resources.</p>
      </div>
      <div class="min-w-0"><CodeBlock code={sandboxFlow} lang="bash" title="create → submit → read" dense /></div>
    </div>
    <div class="mt-12 grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:gap-12" data-reveal>
      <div>
        <h3 class="font-display text-xl font-semibold">Claim when the user is ready</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">Two calls, one human step. A verified email creates or resolves the account and returns a manage key; browser OAuth is available too.</p>
      </div>
      <div class="min-w-0"><CodeBlock code={keyFlow} lang="bash" title="request-code → verify-code → claim" dense /></div>
    </div>
  </section>

  <section class="container-x mt-24" aria-labelledby="flow-heading">
    <h2 id="flow-heading" class="text-3xl font-semibold sm:text-4xl">From no credentials to delivered.</h2>
    <ol class="mt-10 grid gap-12">
      {steps.map((s, i) => (
        <li class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12" data-reveal>
          <div>
            <h3 class="text-2xl font-semibold"><span class="font-mono text-base text-primary tabular">{i + 1}</span> {s.n}</h3>
            <p class="mt-3 text-[16px] leading-relaxed text-muted-foreground">{s.body}</p>
          </div>
          <div class="min-w-0"><CodeBlock code={s.code} lang="bash" dense /></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-x mt-24" aria-labelledby="principles-heading">
    <h2 id="principles-heading" class="text-3xl font-semibold sm:text-4xl">What agent-native means here</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted-foreground">It is a property the whole surface has, checked on every change, not a page in the docs.</p>
    <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group="60">
      {principles.map((p) => (
        <div class="border-t border-border-strong pt-4" data-reveal>
          <dt class="font-display text-lg font-semibold">{p.t}</dt>
          <dd class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{p.b}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="container-x mt-24 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16" aria-labelledby="repo-heading">
    <div data-reveal>
      <h2 id="repo-heading" class="text-3xl font-semibold sm:text-4xl">Leave the wiring where the next agent will look.</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">Site factories and agent scaffolds should write <code class="font-mono text-[0.9em]">postbag.json</code> into the repo and a line into CLAUDE.md or AGENTS.md. The next session, human or agent, finds the form id without guessing. Never hand-write a submit URL.</p>
      <p class="mt-4 text-[15px] text-muted-foreground"><code class="font-mono text-[0.9em]">npx postbag init</code> writes <code class="font-mono text-[0.9em]">postbag.json</code> for you; the MCP server (<code class="font-mono text-[0.9em]">npx -y @postbag/mcp</code>) mirrors the API one tool per operation, plus <code class="font-mono text-[0.9em]">postbag_quickstart</code> and <code class="font-mono text-[0.9em]">postbag_explain</code>.</p>
    </div>
    <div class="min-w-0" data-reveal style="--reveal-delay: 120ms"><CodeBlock code={snippet} lang="markdown" title="CLAUDE.md" /></div>
  </section>

  <Faq items={faqs} class="mt-24" title="Agent questions" />
  <CtaBand title="Let your agent start." body="It can create and test a sandbox Form now. You authenticate only when it is ready to claim the Form and configure delivery." secondary={{ href: "/docs/agents/", label: "Agent guide" }} />
</Base>
