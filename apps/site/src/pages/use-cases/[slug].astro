---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CodeBlock from "@/components/CodeBlock.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { USE_CASES } from "@/content/usecases"
import { breadcrumbLd, faqLd, webPageLd } from "@/lib/seo"
import { SITE_URL } from "@/config"

export function getStaticPaths() {
  return USE_CASES.map((u) => ({ params: { slug: u.slug }, props: { uc: u } }))
}
const { uc } = Astro.props
const path = `/use-cases/${uc.slug}/`
const crumbs = [ { name: "Home", href: "/" }, { name: "Use cases", href: "/use-cases/" }, { name: uc.nav, href: path } ]
const ld = [ webPageLd({ url: `${SITE_URL}${path}`, name: uc.title, description: uc.description }), breadcrumbLd(crumbs), faqLd(uc.faqs) ]
const others = USE_CASES.filter((o) => o.slug !== uc.slug)
---
<Base title={uc.title} description={uc.description} canonical={path} ld={ld} ogImage="/og/default.png">
  <PageHeader title={uc.title} lede={uc.lede} crumbs={crumbs} />
  <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px]">
    <article class="prose-pb max-w-3xl">
      {uc.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{p}</p>)}
          {s.code && <CodeBlock code={s.code.code} lang={s.code.lang} title={s.code.title} />}
        </section>
      ))}
    </article>
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <nav aria-label="Other use cases" class="card p-5">
        <h2 class="font-sans text-[13px] font-semibold">Use cases</h2>
        <ul class="mt-3 space-y-2">{others.map((o) => <li><a href={`/use-cases/${o.slug}/`} class="text-sm text-muted-foreground hover:text-foreground">{o.nav}</a></li>)}</ul>
        <h2 class="mt-6 font-sans text-[13px] font-semibold">Related</h2>
        <ul class="mt-3 space-y-2">{uc.related.map((r) => <li><a href={r.href} class="text-sm text-muted-foreground hover:text-foreground">{r.label}</a></li>)}</ul>
      </nav>
    </aside>
  </div>
  <Faq items={uc.faqs} class="mt-20" />
  <CtaBand />
</Base>
