---
import DocsLayout from "@/layouts/DocsLayout.astro"
import { ERROR_CODES } from "@/content/errors"
import { SITE_URL } from "@/config"

export function getStaticPaths() {
  return ERROR_CODES.map((e) => ({ params: { code: e.code }, props: { e } }))
}
const { e } = Astro.props
const path = `/docs/errors/${e.code}/`
const title = `${e.code} (${e.status}): Postbag API error`
const headings = [{ depth: 2, slug: "what-to-do", text: "What to do" }, { depth: 2, slug: "error-shape", text: "Error shape" }]
---
<DocsLayout
  title={title}
  description={e.hint}
  slug={`errors/${e.code}`}
  published="2026-08-21"
  modified="2026-08-24"
  headings={headings}
  markdownAlternate={false}
>
  <p class="error-http"><span>HTTP</span> {e.status}</p>
  <h2 id="what-to-do">What to do</h2>
  <p>{e.hint}</p>
  <p>{e.more}</p>
  <h2 id="error-shape">Error shape</h2>
  <pre data-language="json"><code>{`{ "error": { "code": "${e.code}", "message": "…", "hint": "${e.hint}", "docs": "${SITE_URL}${path}" } }`}</code></pre>
  <p>All codes are listed on the <a href="/docs/errors/">error reference</a>. Conventions for the envelope, hints and <code>next[]</code> are in the <a href="/docs/api/">API overview</a>.</p>
</DocsLayout>

<style>
  .error-http { display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 0; color: var(--foreground); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 650; }
  .error-http span { border-radius: var(--radius-sm); padding: 0.2rem 0.38rem; color: var(--primary-foreground); background: var(--primary); font-size: 0.65rem; letter-spacing: 0.06em; }
</style>
