---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CtaBand from "@/components/CtaBand.astro"
import ContactForm from "@/components/ContactForm.astro"
import { AUTHOR, GITHUB_URL, SITE_CONTACT_FORM_ID, SITE_URL } from "@/config"
import { breadcrumbLd, webPageLd } from "@/lib/seo"
const crumbs = [ { name: "Home", href: "/" }, { name: "About", href: "/about/" } ]
const description = "Why Postbag exists: a dependable, open-source form backend built for agents, shaped by a live lead-routing system that could not lose a Submission."
const ld = [ webPageLd({ url: `${SITE_URL}/about/`, name: "About Postbag", description }), breadcrumbLd(crumbs), { "@type": "AboutPage", url: `${SITE_URL}/about/`, mainEntity: { "@id": `${SITE_URL}/#organization` } } ]
const principles = [
  ["Save first", "A Submission becomes a database row before Postbag tries to deliver it anywhere."],
  ["One contract", "The dashboard, API, SDK, CLI and MCP server all operate the same product."],
  ["Yours to run", "Postbag Cloud and self-hosting use the same open-source code and core capabilities."],
]
---
<Base title="About" description={description} canonical="/about/" ld={ld}>
  <PageHeader eyebrow="Why Postbag" title="Forms deserve a dependable place to land." lede="Postbag grew out of a live system routing leads from many small websites to one business. Losing a Submission was never an acceptable failure mode. It still is not." crumbs={crumbs} />
  <section class="container-x origin-grid" aria-labelledby="origin-heading">
    <div class="origin-copy" data-reveal>
      <p class="section-label">The origin</p>
      <h2 id="origin-heading">The first version had a very ordinary job.</h2>
      <p>Receive forms from a growing set of websites, keep every lead safe, and send each one to the right place. The sites did not all collect the same fields. The Destination could have a bad day. The person building the next site might be an agent.</p>
      <p>That ordinary job exposed the product: a durable place between a Form and everything that happens after it.</p>
    </div>
    <div class="origin-scene" aria-label="Many Forms settling into one receiving surface" data-reveal style="--reveal-delay: var(--duration-quick)">
      <span class="form-plane plane-one"></span><span class="form-plane plane-two"></span><span class="form-plane plane-three"></span>
      <div class="receiving-line"><span></span></div>
      <p>many sites <b>one dependable record</b></p>
    </div>
  </section>
  <section class="container-x principle-field" aria-labelledby="principles-heading">
    <div class="principle-intro" data-reveal>
      <p class="section-label">What stayed</p>
      <h2 id="principles-heading">The useful constraints became the principles.</h2>
      <p>No dramatic reinvention. Just the rules that kept the original system understandable when more sites, people and Destinations arrived.</p>
    </div>
    <ol class="principle-list">
      {principles.map(([title, body], index) => (
        <li data-reveal style={`--reveal-delay: calc(var(--duration-quick) * ${index * 0.4})`}><span class="principle-number">0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>
      ))}
    </ol>
  </section>
  <section class="container-x maker" aria-labelledby="maker-heading">
    <div data-reveal><p class="section-label">Who</p><h2 id="maker-heading">Built by one developer, in the open.</h2></div>
    <div class="maker-note" data-reveal style="--reveal-delay: var(--duration-micro)">
      <p>Postbag is built by <a href={AUTHOR.url}>{AUTHOR.name}</a>, an independent developer who runs small business websites and the systems behind them. The repository is public, the server and product are AGPL-3.0, and the SDK, CLI and MCP server are MIT.</p>
      <a class="source-link" href={GITHUB_URL} rel="noopener">Read the source <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="container-x contact-grid" id="contact" aria-labelledby="contact-heading">
    <div class="contact-copy" data-reveal>
      <p class="section-label">Contact</p><h2 id="contact-heading">A real Form, routed by Postbag.</h2>
      <p>Questions about the product, self-hosting or security are welcome. This form posts to Postbag and routes to Fahim's inbox.</p>
      <p class="privacy-note" id="privacy">This site sets no tracking cookies. Postbag stores the data and delivery metadata needed to route your message. Read the <a href="/legal/privacy/">privacy policy</a>, <a href="/legal/terms/">terms</a>, <a href="/legal/dpa/">DPA</a> and <a href="/legal/subprocessors/">sub-processors list</a>.</p>
    </div>
    <div class="contact-surface" data-reveal style="--reveal-delay: var(--duration-quick)"><ContactForm formId={SITE_CONTACT_FORM_ID} /></div>
  </section>
  <CtaBand title="Give your forms somewhere to go." body="Your agent can create and test a working Form before you sign up. Claim it when you are ready." />
</Base>
<style>
  .section-label{font-family:var(--font-mono);font-size:.72rem;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--primary)}
  h2{font-size:clamp(2rem,4vw,3.35rem);line-height:1.02;font-weight:600}.origin-grid{display:grid;gap:3rem;align-items:center;padding-block:3rem 6rem}.origin-copy{max-width:38rem}.origin-copy h2,.principle-intro h2,.maker h2,.contact-copy h2{margin-top:.8rem}.origin-copy>p:not(.section-label),.principle-intro>p:not(.section-label),.maker-note p,.contact-copy>p:not(.section-label){margin-top:1.25rem;color:var(--muted-foreground);font-size:1.05rem;line-height:1.75}
  .origin-scene{position:relative;min-height:23rem;overflow:hidden;border-radius:calc(var(--radius) + 16px);background:linear-gradient(155deg,var(--foreground),var(--ink-code));box-shadow:var(--shadow-xl)}.origin-scene:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 42%,var(--accent),transparent 45%);opacity:.3}.form-plane{position:absolute;left:50%;width:9rem;height:5.6rem;border-radius:var(--radius);background:var(--primary-foreground);box-shadow:var(--shadow-lg);transform:translateX(-50%) rotate(var(--r))}.plane-one{top:2.5rem;--r:-8deg}.plane-two{top:5rem;margin-left:-5.5rem;--r:-17deg;opacity:.72}.plane-three{top:4.5rem;margin-left:5.2rem;--r:13deg;opacity:.86}.receiving-line{position:absolute;left:12%;right:12%;bottom:6.2rem;height:5.5rem;overflow:hidden;border-radius:50% 50% 18% 18%;background:var(--background);box-shadow:0 -1px 0 var(--border-strong),var(--shadow-xl)}.receiving-line span{position:absolute;inset:.75rem 9% auto;height:1px;background:var(--primary);box-shadow:0 0 1.8rem var(--primary)}.origin-scene p{position:absolute;inset:auto 1.5rem 1.4rem;display:flex;justify-content:space-between;gap:1rem;color:var(--primary-foreground);font-family:var(--font-mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase}.origin-scene b{color:var(--primary);font-weight:650}
  .principle-field{display:grid;gap:3rem;padding-block:5rem}.principle-intro{max-width:32rem}.principle-list{display:grid}.principle-list li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.5rem 0;border-top:1px solid var(--border-strong)}.principle-number{font-family:var(--font-mono);font-size:.75rem;color:var(--primary)}.principle-list h3{font-size:1.25rem;font-weight:600}.principle-list p{margin-top:.45rem;max-width:35rem;color:var(--muted-foreground);line-height:1.65}
  .maker{display:grid;gap:2rem;margin-block:5rem;padding-block:3rem;border-block:1px solid var(--border-strong)}.maker-note{max-width:38rem}.maker-note a{color:var(--foreground);text-decoration:underline;text-underline-offset:4px}.source-link{display:inline-flex;align-items:center;gap:.5rem;min-height:2.75rem;margin-top:1.25rem;font-weight:600;text-decoration:none!important}.source-link span{color:var(--primary);transition:transform var(--duration-quick) var(--ease-smooth-out)}.source-link:hover span{transform:translate(3px,-3px)}
  .contact-grid{display:grid;gap:3rem;align-items:start;padding-block:5rem}.contact-copy{max-width:34rem}.privacy-note{font-size:.88rem!important}.privacy-note a{color:var(--foreground);text-decoration:underline;text-underline-offset:3px}.contact-surface{padding:clamp(1.1rem,4vw,2.25rem);border-radius:calc(var(--radius) + 16px);background:var(--surface);box-shadow:var(--shadow-lg)}
  @media(min-width:52rem){.origin-grid,.principle-field,.maker,.contact-grid{grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:clamp(4rem,8vw,8rem)}.origin-grid{padding-top:5rem}.maker{align-items:start}}@media(prefers-reduced-motion:reduce){.source-link span{transition-duration:1ms}}
</style>
