---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CodeBlock from "@/components/CodeBlock.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { FEATURES } from "@/content/features"
import { breadcrumbLd, faqLd, webPageLd } from "@/lib/seo"
import { SITE_URL } from "@/config"

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug }, props: { feature: f } }))
}
const { feature } = Astro.props
const path = `/features/${feature.slug}/`
const crumbs = [ { name: "Home", href: "/" }, { name: "Features", href: "/features/" }, { name: feature.nav, href: path } ]
const ld = [ webPageLd({ url: `${SITE_URL}${path}`, name: feature.title, description: feature.description }), breadcrumbLd(crumbs), faqLd(feature.faqs) ]
const others = FEATURES.filter((f) => f.slug !== feature.slug)
---
<Base title={feature.title} description={feature.description} canonical={path} ld={ld} ogImage="/og/features.png">
  <PageHeader title={feature.title} lede={feature.lede} crumbs={crumbs} />
  <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,1fr)_260px]">
    <article class="prose-pb max-w-3xl">
      <p class="rounded-xl bg-accent/60 px-5 py-4 text-[16px] leading-relaxed text-foreground"><strong>In short:</strong> {feature.definition}</p>
      {feature.sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{p}</p>)}
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
          {s.code && <CodeBlock code={s.code.code} lang={s.code.lang} title={s.code.title} />}
        </section>
      ))}
    </article>
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <nav aria-label="Other features" class="card p-5">
        <h2 class="font-sans text-[13px] font-semibold">Features</h2>
        <ul class="mt-3 space-y-2">
          {others.map((f) => <li><a href={`/features/${f.slug}/`} class="text-sm text-muted-foreground hover:text-foreground">{f.nav}</a></li>)}
        </ul>
        <h2 class="mt-6 font-sans text-[13px] font-semibold">Related</h2>
        <ul class="mt-3 space-y-2">
          {feature.related.map((r) => <li><a href={r.href} class="text-sm text-muted-foreground hover:text-foreground">{r.label}</a></li>)}
        </ul>
      </nav>
    </aside>
  </div>
  <Faq items={feature.faqs} class="mt-20" />
  <CtaBand />
</Base>
