---
import Base from "@/layouts/Base.astro"
import PageHeader from "@/components/PageHeader.astro"
import CodeBlock from "@/components/CodeBlock.astro"
import Faq from "@/components/Faq.astro"
import CtaBand from "@/components/CtaBand.astro"
import { FEATURES } from "@/content/features"
import { breadcrumbLd, faqLd, webPageLd } from "@/lib/seo"
import { SITE_URL } from "@/config"
import { ArrowUpRight } from "@lucide/astro"

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug }, props: { feature: f } }))
}

const { feature } = Astro.props
const path = `/features/${feature.slug}/`
const crumbs = [ { name: "Home", href: "/" }, { name: "Features", href: "/features/" }, { name: feature.nav, href: path } ]
const ld = [ webPageLd({ url: `${SITE_URL}${path}`, name: feature.title, description: feature.description }), breadcrumbLd(crumbs), faqLd(feature.faqs) ]
const others = FEATURES.filter((f) => f.slug !== feature.slug)
---
<Base title={feature.title} description={feature.description} canonical={path} ld={ld} ogImage="/og/features.png">
  <PageHeader title={feature.title} lede={feature.lede} crumbs={crumbs} />

  <div class="container-x feature-detail">
    <div class="feature-reading">
      <aside class="feature-summary" data-reveal>
        <p>In plain terms</p>
        <div>{feature.definition}</div>
      </aside>

      <article class="feature-article">
        {feature.sections.map((section) => (
          <section class="feature-section" data-reveal>
            <div class="feature-section-heading"><h2>{section.h}</h2></div>
            <div class="feature-section-body">
              {section.p.map((paragraph) => <p>{paragraph}</p>)}
              {section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}
              {section.code && <CodeBlock code={section.code.code} lang={section.code.lang} title={section.code.title} />}
            </div>
          </section>
        ))}
      </article>
    </div>

    <aside class="feature-links" data-reveal>
      <nav aria-label="Feature navigation">
        <p>Keep exploring</p>
        <ul>
          {others.map((item) => <li><a href={`/features/${item.slug}/`}>{item.nav}<ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" /></a></li>)}
        </ul>
      </nav>
      <nav aria-label="Related pages">
        <p>Related</p>
        <ul>
          {feature.related.map((item) => <li><a href={item.href}>{item.label}<ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" /></a></li>)}
        </ul>
      </nav>
    </aside>
  </div>

  <Faq items={feature.faqs} class="mt-24" />
  <CtaBand />
</Base>

<style>
  .feature-detail { display: grid; gap: clamp(3.5rem, 8vw, 6.5rem); padding-top: clamp(2.5rem, 6vw, 5rem); }
  .feature-reading { min-width: 0; }
  .feature-summary { display: grid; gap: 0.8rem; padding: clamp(1.4rem, 3vw, 2rem); border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--border)); border-radius: calc(var(--radius) + 10px); background: color-mix(in srgb, var(--accent) 82%, var(--background)); box-shadow: var(--shadow-sm); }
  .feature-summary p, .feature-links p { color: var(--primary); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .feature-summary div { max-width: 48rem; color: var(--accent-foreground); font-family: var(--font-display); font-size: clamp(1.12rem, 1.7vw, 1.35rem); line-height: 1.5; letter-spacing: -0.012em; }
  .feature-article { min-width: 0; }
  .feature-section { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.35rem; padding: clamp(2.5rem, 6vw, 4.5rem) 0; border-top: 1px solid var(--border); }
  .feature-section:first-child { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .feature-section h2 { max-width: 22ch; font-size: clamp(1.85rem, 3.4vw, 2.8rem); font-weight: 580; line-height: 1.06; letter-spacing: -0.025em; text-wrap: balance; }
  .feature-section-heading, .feature-section-body { min-width: 0; }
  .feature-section-body { width: 100%; max-width: 46rem; color: var(--muted-foreground); font-size: clamp(1rem, 1.4vw, 1.08rem); line-height: 1.75; }
  .feature-section-body p + p { margin-top: 1rem; }
  .feature-section-body :global(ul) { display: grid; gap: 0.75rem; margin-top: 1.25rem; padding: 0; list-style: none; }
  .feature-section-body :global(li) { position: relative; padding-left: 1.25rem; }
  .feature-section-body :global(li)::before { position: absolute; top: 0.62rem; left: 0; width: 0.45rem; height: 0.45rem; border-radius: 999px; background: var(--primary); content: ""; }
  .feature-section-body :global(.code-panel) { margin-top: 1.5rem; box-shadow: var(--shadow-md); }
  .feature-links { display: grid; align-content: start; gap: 2.5rem; }
  .feature-links ul { margin-top: 0.7rem; }
  .feature-links li + li { margin-top: 0.1rem; }
  .feature-links a { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 0; border-bottom: 1px solid var(--border); color: var(--muted-foreground); font-size: 0.92rem; text-decoration: none; transition-property: color, transform; transition-duration: var(--duration-fast); transition-timing-function: var(--ease-smooth-out); }
  .feature-links a:hover { color: var(--primary); transform: translateX(0.2rem); }
  .feature-links a:active { transform: translateX(0.1rem); }
  @media (min-width: 40rem) {
    .feature-summary { grid-template-columns: 8rem minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  }
  @media (min-width: 64rem) {
    .feature-detail { grid-template-columns: minmax(0, 1fr) minmax(15rem, 17rem); align-items: start; }
    .feature-links { position: sticky; top: 6.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .feature-links a { transition: none; }
    .feature-links a:hover, .feature-links a:active { transform: none; }
  }
</style>
