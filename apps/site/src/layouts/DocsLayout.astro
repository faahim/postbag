---
import Base from "@/layouts/Base.astro"
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import { getCollection } from "astro:content"
import { articleLd, breadcrumbLd } from "@/lib/seo"
import { SITE_URL } from "@/config"

interface Props { title: string; description: string; slug: string; published: string; modified: string; headings?: { depth: number; slug: string; text: string }[] }
const { title, description, slug, published, modified, headings = [] } = Astro.props
const path = slug === "index" ? "/docs/" : `/docs/${slug}/`
const all = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order)
const sections = ["Start", "Reference", "Guides", "Operate"] as const
const crumbs = slug === "index" ? [ { name: "Home", href: "/" }, { name: "Docs", href: "/docs/" } ] : [ { name: "Home", href: "/" }, { name: "Docs", href: "/docs/" }, { name: title, href: path } ]
const ld = [ articleLd({ title, description, url: `${SITE_URL}${path}`, published, modified }), breadcrumbLd(crumbs) ]
const toc = headings.filter((h) => h.depth === 2)
---
<Base title={slug === "index" ? "Documentation" : title} description={description} canonical={path} ld={ld} ogType="article" ogImage="/og/docs.png" markdownAlternate={`${path}index.md`} published={published} modified={modified}>
  <div class="container-x grid gap-10 pt-10 lg:grid-cols-[220px_minmax(0,1fr)_200px] lg:gap-12">
    <nav aria-label="Documentation" class="lg:sticky lg:top-24 lg:self-start">
      <details class="lg:hidden">
        <summary class="cursor-pointer list-none rounded-md bg-surface-2 px-3 py-2 text-sm font-medium">All docs</summary>
        <div class="mt-3 grid gap-5">
          {sections.map((s) => (
            <div>
              <p class="text-[12px] font-semibold text-muted-foreground">{s}</p>
              <ul class="mt-1.5 space-y-1">{all.filter((d) => d.data.section === s).map((d) => <li><a href={d.id === "index" ? "/docs/" : `/docs/${d.id}/`} class="block rounded px-2 py-1 text-sm text-muted-foreground hover:bg-surface-2 hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground" aria-current={d.id === slug ? "page" : undefined}>{d.data.title.split(":")[0]}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </details>
      <div class="hidden lg:grid lg:gap-6">
        {sections.map((s) => (
          <div>
            <p class="text-[12px] font-semibold text-muted-foreground">{s}</p>
            <ul class="mt-1.5 space-y-0.5">{all.filter((d) => d.data.section === s).map((d) => <li><a href={d.id === "index" ? "/docs/" : `/docs/${d.id}/`} class="-mx-2 block rounded px-2 py-1 text-[13.5px] text-muted-foreground transition-colors duration-150 hover:bg-surface-2 hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:font-medium aria-[current=page]:text-accent-foreground" aria-current={d.id === slug ? "page" : undefined}>{d.data.title.split(":")[0]}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </nav>
    <article class="min-w-0">
      <Breadcrumbs crumbs={crumbs} class="mb-5" />
      <h1 class="text-4xl font-semibold leading-[1.08] sm:text-[2.75rem]">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{description}</p>
      <p class="mt-3 text-xs text-muted-foreground">Updated <time datetime={modified}>{new Date(modified).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</time> · <a href={`${path}index.md`} class="underline-offset-2 hover:underline">Markdown</a></p>
      <div class="prose-pb mt-8">
        <slot />
      </div>
      <slot name="after" />
    </article>
    <aside class="hidden lg:block lg:sticky lg:top-24 lg:self-start">
      {toc.length > 0 && (
        <nav aria-label="On this page">
          <p class="text-[12px] font-semibold text-muted-foreground">On this page</p>
          <ul class="mt-2 space-y-1 border-l border-border">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="-ml-px block border-l border-transparent py-0.5 pl-3 text-[13px] text-muted-foreground transition-colors duration-150 hover:border-foreground hover:text-foreground">{h.text}</a></li>)}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</Base>
