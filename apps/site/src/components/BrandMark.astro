    <linearGradient id="pbm-outerStroke" x1="238" y1="451" x2="756" y2="839" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF" stop-opacity="0.54"/>
      <stop offset="0.33" stop-color="#F0F2FF" stop-opacity="0.28"/>
