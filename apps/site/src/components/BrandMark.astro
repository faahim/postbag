    </radialGradient>
    <radialGradient id="pbm-pocketRightEdge" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(788 607) scale(78 270)">
      <stop stop-color="#FFFFFF" stop-opacity="0.42"/>
