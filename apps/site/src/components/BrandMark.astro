      <stop offset="0.15" stop-color="#F7F8FF" stop-opacity="0.52"/>
      <stop offset="0.55" stop-color="#E6E9FE" stop-opacity="0.34"/>
      <stop offset="0.84" stop-color="#F8F9FF" stop-opacity="0.58"/>
