---
import { SIGNUP_URL } from "@/config"
import { Check, Copy } from "@lucide/astro"
interface PrimaryAction { href?: string; label: string; copyText?: string }
interface Props { title?: string; body?: string; primary?: PrimaryAction; secondary?: { href: string; label: string } }
const {
  title = "Give the Form job to your agent.",
  body = "It can create, wire and test a working Form before you sign up. Claim it when you want to keep it and add a Destination and Route.",
  primary = { href: SIGNUP_URL, label: "Create a form" },
  secondary = { href: "/docs/quickstart/", label: "Read the quickstart" },
} = Astro.props
---
<section class="container-x mt-24">
  <div class="relative overflow-hidden rounded-2xl bg-brand-ink px-6 py-14 text-brand-form shadow-xl sm:px-12 sm:py-16" data-reveal>
    <img src="/brand/social-routing-field-v1.webp" alt="" width="1800" height="945" loading="lazy" class="pointer-events-none absolute inset-0 size-full object-cover opacity-80" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-brand-ink via-brand-ink/90 to-brand-ink/20" aria-hidden="true"></div>
    <div class="relative max-w-[40rem]">
      <h2 class="text-3xl font-semibold text-brand-form sm:text-4xl">{title}</h2>
      <p class="mt-4 text-base leading-relaxed text-brand-muted sm:text-lg">{body}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {primary.copyText ? (
          <button
            type="button"
            class="btn btn-primary copy-agent-button"
            data-copy-agent
            data-copy-text={primary.copyText}
            aria-label={primary.label}
          >
            <span class="copy-agent-states" aria-hidden="true">
              <span class="copy-agent-state" data-copy-state="default">
                <Copy size={16} stroke-width={2} />
                <span>{primary.label}</span>
              </span>
              <span class="copy-agent-state" data-copy-state="success">
                <span class="t-success-check" data-state="out"><Check size={17} stroke-width={2.4} /></span>
                <span>Copied</span>
              </span>
            </span>
            <span class="sr-only" data-copy-announcement aria-live="polite"></span>
          </button>
        ) : (
          <a href={primary.href ?? SIGNUP_URL} class="btn btn-primary">{primary.label}</a>
        )}
        <a href={secondary.href} class="btn bg-brand-form/10 text-brand-form hover:bg-brand-form/15">{secondary.label}</a>
      </div>
    </div>
  </div>
</section>
