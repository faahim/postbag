---
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import RoutingMark from "@/components/RoutingMark.astro"
import type { Crumb } from "@/lib/seo"
interface Props { title: string; lede: string; crumbs?: Crumb[]; eyebrow?: string; modified?: string }
const { title, lede, crumbs, eyebrow, modified } = Astro.props
---
<header class="relative overflow-hidden border-b border-border/70 bg-gradient-to-b from-accent/55 to-background">
  <RoutingMark size={250} tone="accent" status="sent" class="pointer-events-none absolute -right-12 -top-20 opacity-[0.08]" title="" />
  <div class="container-x relative pt-10 pb-10 sm:pt-16 sm:pb-16">
    {crumbs && <Breadcrumbs crumbs={crumbs} class="mb-7" />}
    {eyebrow && <p class="mb-4 font-mono text-[12px] uppercase tracking-[0.12em] text-primary">{eyebrow}</p>}
    <h1 class="max-w-4xl text-4xl font-semibold leading-[1.02] sm:text-5xl lg:text-[3.65rem]">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">{lede}</p>
    {modified && <p class="mt-5 text-xs text-muted-foreground">Last updated <time datetime={modified}>{new Date(modified).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</time></p>}
    <slot />
  </div>
</header>
