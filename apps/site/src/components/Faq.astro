---
import type { Faq } from "@/lib/seo"
interface Props { items: Faq[]; title?: string; class?: string }
const { items, title = "Questions, answered", class: className = "" } = Astro.props
---
<section class={`container-x ${className}`} aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-3xl font-semibold sm:text-4xl" data-reveal>{title}</h2>
  <div class="mt-8 max-w-3xl divide-y divide-border border-y border-border" data-reveal style="--reveal-delay: var(--duration-micro)">
    {items.map((f) => (
      <details class="faq-item group py-1">
        <summary class="faq-summary flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-[17px] font-medium [&::-webkit-details-marker]:hidden">
          <span class="faq-question">{f.q}</span>
          <svg class="faq-plus h-5 w-5 shrink-0 text-muted-foreground group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </summary>
        <div class="faq-answer pb-5 pr-10 text-[16px] leading-relaxed text-muted-foreground" set:html={f.a} />
      </details>
    ))}
  </div>
</section>

<style>
  /* Accordion: height interpolates where the browser supports it (interpolate-size /
     ::details-content); elsewhere it opens instantly — never broken, just less soft. */
  .faq-item { interpolate-size: allow-keywords; }
  .faq-item::details-content {
    display: block;
    height: 0;
    overflow: clip;
    transition:
      height var(--duration-medium) var(--ease-smooth-out),
      content-visibility var(--duration-medium) allow-discrete;
  }
  .faq-item[open]::details-content { height: auto; }
  .faq-answer {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--duration-medium) var(--ease-smooth-out),
      transform var(--duration-medium) var(--ease-smooth-out);
  }
  .faq-item[open] .faq-answer { opacity: 1; transform: translateY(0); }
  .faq-question,
  .faq-plus {
    transition-property: color, transform;
    transition-duration: var(--duration-quick), var(--duration-medium);
    transition-timing-function: var(--ease-smooth-out);
  }
  .faq-summary:hover .faq-question { color: var(--primary); }
  .faq-summary:hover .faq-plus { color: var(--foreground); }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content, .faq-answer, .faq-plus { transition: none; }
    .faq-answer { opacity: 1; transform: none; }
  }
</style>
