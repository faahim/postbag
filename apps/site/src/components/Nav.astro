---
import { LOGIN_URL, SIGNUP_URL } from "@/config"
import BrandMark from "@/components/BrandMark.astro"
import { ArrowUpRight, LogIn, Menu, X } from "@lucide/astro"
const links = [
  { href: "/features/", label: "Features" },
  { href: "/for-ai-agents/", label: "For AI agents" },
  { href: "/docs/", label: "Docs" },
  { href: "/pricing/", label: "Pricing" },
  { href: "/compare/", label: "Compare" },
]
const current = Astro.url.pathname
const overlaysHero = current === "/"
---
{overlaysHero && <span class="nav-scroll-sentinel" data-nav-sentinel aria-hidden="true"></span>}
<header
  class:list={[
    "site-nav z-40",
    overlaysHero
      ? "fixed inset-x-0 top-0"
      : "sticky top-0 border-b border-border/70 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/70",
  ]}
  data-hero-overlay={overlaysHero ? "" : undefined}
>
  <nav class="container-x flex h-16 items-center justify-between gap-6" aria-label="Primary">
    <a href="/" class="flex items-center gap-2.5 font-display text-[19px] font-semibold tracking-tight" aria-label="Postbag home" data-brand-trigger>
      <BrandMark class="size-7 shrink-0" />
      Postbag
    </a>
    <ul class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={current.startsWith(l.href) ? "page" : undefined}
            class="rounded-md px-3 py-2 text-[15px] text-muted-foreground transition-colors duration-(--duration-quick) hover:bg-surface-2 hover:text-foreground aria-[current=page]:text-foreground"
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a href={LOGIN_URL} class="btn btn-ghost btn-sm hidden sm:inline-flex">Sign in</a>
      <a href={SIGNUP_URL} class="btn btn-primary btn-sm">Create a form</a>
      <button type="button" id="nav-toggle" class="mobile-nav-toggle btn btn-ghost h-10 w-10 px-0 lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span class="mobile-nav-toggle-icon" data-menu-icon aria-hidden="true"><Menu size={20} stroke-width={1.75} /></span>
        <span class="mobile-nav-toggle-icon" data-close-icon aria-hidden="true"><X size={20} stroke-width={1.75} /></span>
      </button>
    </div>
  </nav>
  <div id="mobile-nav" class="mobile-nav-drawer lg:hidden" data-state="closed" aria-hidden="true" aria-label="Menu" role="dialog" aria-modal="true" tabindex="-1" inert>
    <div class="mobile-nav-ambient" aria-hidden="true">
      <BrandMark ambient />
    </div>
    <div class="container-x mobile-nav-content">
      <nav aria-label="Mobile navigation">
        <p class="mobile-nav-kicker">Find your way around.</p>
        <ul class="mobile-nav-links">
          {links.map((l, index) => (
            <li style={`--menu-index: ${index}`}>
              <a href={l.href} aria-current={current.startsWith(l.href) ? "page" : undefined}>
                <span>{l.label}</span>
                <ArrowUpRight size={21} stroke-width={1.65} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mobile-nav-footer">
        <p>Open source. Agent-native. Yours.</p>
        <a href={LOGIN_URL} class="mobile-nav-sign-in">
          <LogIn size={17} stroke-width={1.8} aria-hidden="true" />
          <span>Sign in</span>
        </a>
      </div>
    </div>
  </div>
</header>
<script>
  const navToggle = document.getElementById("nav-toggle")
  const mobile = document.getElementById("mobile-nav")
  const header = document.querySelector<HTMLElement>("[data-hero-overlay]")
  const siteNav = document.querySelector<HTMLElement>(".site-nav")
  const sentinel = document.querySelector<HTMLElement>("[data-nav-sentinel]")
  if (header && sentinel) {
    const observer = new IntersectionObserver(([entry]) => {
      header.toggleAttribute("data-scrolled", !entry?.isIntersecting)
    }, { rootMargin: "-8px 0px 0px", threshold: 0 })
    observer.observe(sentinel)
  }
  let returnFocus: HTMLElement | null = null

  const setMenuOpen = (open: boolean) => {
    if (!navToggle || !mobile || !siteNav) return
    if (open) returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : navToggle

    mobile.dataset.state = open ? "open" : "closed"
    mobile.setAttribute("aria-hidden", String(!open))
    if (open) mobile.removeAttribute("inert")
    else mobile.setAttribute("inert", "")
    navToggle.setAttribute("aria-expanded", String(open))
    navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu")
    siteNav.toggleAttribute("data-menu-open", open)
    document.documentElement.toggleAttribute("data-mobile-nav-open", open)

    if (open) {
      requestAnimationFrame(() => mobile.focus())
    } else if (returnFocus) {
      returnFocus.focus()
      returnFocus = null
    }
  }

  navToggle?.addEventListener("click", () => setMenuOpen(navToggle.getAttribute("aria-expanded") !== "true"))
  mobile?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)))

  document.addEventListener("keydown", (event) => {
    if (navToggle?.getAttribute("aria-expanded") !== "true" || !mobile) return
    if (event.key === "Escape") {
      event.preventDefault()
      setMenuOpen(false)
      return
    }
    if (event.key !== "Tab") return

    const focusable = [navToggle, ...mobile.querySelectorAll<HTMLElement>("a")]
    const first = focusable[0]
    const last = focusable.at(-1)
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault()
      last?.focus()
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault()
      first?.focus()
    }
  })

  window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
    if (event.matches) setMenuOpen(false)
  })
</script>
