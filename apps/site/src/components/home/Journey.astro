---
import Postmark from "@/components/Postmark.astro"
import { EXAMPLE, RETRY } from "@/config"
const stages = [
  {
    id: "arrive",
    title: "It arrives.",
    body: "POST /s/{form} takes urlencoded, multipart or JSON, up to 256 KB. Honeypot, origin allowlist, per-form rate limit and Turnstile all run first, and every outcome is stored with a status. Spam is a label, not a bin.",
    link: { href: "/features/spam-protection/", label: "How spam is handled" },
  },
  {
    id: "row",
    title: "It is a row before it is anything else.",
    body: "One transaction inserts the submission, plans one delivery per matching route, and writes the event. The HTTP 200 is your receipt. Nothing in the write path talks to a third party.",
    link: { href: "/features/never-lose-a-submission/", label: "Why the database makes it correct" },
  },
  {
    id: "drain",
    title: "The outbox drains.",
    body: `A worker claims pending deliveries with SELECT … FOR UPDATE SKIP LOCKED, wakes on NOTIFY and on a 15-second tick regardless. Failures back off as ${RETRY.formula}, then go dead and loud. Many workers are safe by construction.`,
    link: { href: "/docs/architecture/", label: "The outbox, explained" },
  },
  {
    id: "stamped",
    title: "Every attempt is on the record.",
    body: "Each delivery keeps its payload snapshot, attempts, last error and the provider's response. Retry from the dashboard or the API. Submissions are only ever deleted by you or by your retention policy.",
    link: { href: "/docs/api/", label: "Deliveries in the API" },
  },
]
---
<section class="container-x mt-28 sm:mt-36" aria-labelledby="journey-heading" id="journey" data-journey>
  <div class="max-w-2xl" data-reveal>
    <h2 id="journey-heading" class="text-3xl font-semibold sm:text-4xl">What happens to a submission</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">The database makes it correct; events make it fast. If every event stream died, every submission would still arrive. Late, never lost.</p>
  </div>

  <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-20">
    <!-- Sticky visual: a delivery record that fills in as the reader scrolls the stages. -->
    <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
      <figure class="card relative max-w-full overflow-hidden p-0 shadow-lg" aria-label="Diagram of a submission record being stored, routed and delivered">
        <div class="flex h-10 items-center justify-between border-b border-border px-4 font-mono text-[12px] text-muted-foreground">
          <span>submission <span class="text-foreground">{EXAMPLE.submission}</span></span>
          <span class="j-status chip shrink-0" data-j="status">incoming</span>
        </div>
        <div class="relative grid gap-4 overflow-x-auto p-5 font-mono text-[12px] sm:text-[12.5px]">
          <!-- Stage 1: the request -->
          <div class="j-block" data-j="request">
            <p class="text-muted-foreground">POST /s/{EXAMPLE.form} · application/json · 412 B</p>
            <pre class="mt-2 rounded-md bg-background p-3 leading-relaxed hairline">{`{ "email": "maja@kontorsautomat.se",\n  "message": "Two machines for the Solna office?",\n  "_gotcha": "" }`}</pre>
          </div>
          <!-- Stage 2: the row + planned deliveries -->
          <div class="j-block" data-j="row">
            <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 rounded-md bg-background p-3 hairline">
              <span class="text-muted-foreground">status</span><span class="j-field" data-j="row-status">received</span>
              <span class="text-muted-foreground">spam</span><span>score 0 · honeypot clean</span>
              <span class="text-muted-foreground">schema</span><span>v3 · no drift</span>
              <span class="text-muted-foreground">idempotency</span><span>unique (form, key) ✓</span>
            </div>
            <p class="mt-3 text-muted-foreground">deliveries planned in the same transaction</p>
            <ul class="mt-1.5 grid gap-1.5">
              <li class="j-delivery flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-md bg-background px-3 py-2 hairline" data-j="d1">
                <span><span class="text-muted-foreground">dl_a91x02</span> → email · ops@honestbox.se</span>
                <span class="flex items-center gap-1.5"><span class="j-dstatus" data-j="d1-status">pending</span><span class="j-stamp"><Postmark status="sent" size={18} tone="status" title="Sent" /></span></span>
              </li>
              <li class="j-delivery flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-md bg-background px-3 py-2 hairline" data-j="d2">
                <span><span class="text-muted-foreground">dl_a91x03</span> → webhook · crm.dekhval.com</span>
                <span class="flex items-center gap-1.5"><span class="j-dstatus" data-j="d2-status">pending</span><span class="j-stamp"><Postmark status="sent" size={18} tone="status" title="Sent" /></span></span>
              </li>
              <li class="j-delivery flex flex-wrap items-center justify-between gap-x-3 gap-y-1 rounded-md bg-background px-3 py-2 hairline" data-j="d3">
                <span><span class="text-muted-foreground">dl_a91x04</span> → telegram · sales chat</span>
                <span class="flex items-center gap-1.5"><span class="j-dstatus" data-j="d3-status">pending</span><span class="j-stamp"><Postmark status="sent" size={18} tone="status" title="Sent" /></span></span>
              </li>
            </ul>
          </div>
          <!-- Stage 3/4: worker log -->
          <div class="j-block" data-j="log">
            <p class="text-muted-foreground">worker</p>
            <ol class="mt-1.5 grid gap-1 break-words text-muted-foreground">
              <li class="j-line" data-j="l1"><span class="text-foreground">NOTIFY</span> postbag_deliveries · claimed 3 (skip locked)</li>
              <li class="j-line" data-j="l2">dl_a91x02 email → 200 · 412 ms</li>
              <li class="j-line" data-j="l3">dl_a91x03 webhook → 503 · retry in 30 s ± 20%</li>
              <li class="j-line" data-j="l4">dl_a91x04 telegram → 200 · 188 ms</li>
              <li class="j-line" data-j="l5">dl_a91x03 webhook → 200 · attempt 2 · 964 ms</li>
            </ol>
          </div>
          <!-- The big postmark -->
          <div class="j-bigstamp pointer-events-none absolute right-5 top-4 hidden sm:block" aria-hidden="true"><Postmark status="sent" size={88} /></div>
        </div>
      </figure>
    </div>

    <ol class="grid min-w-0 gap-16 lg:gap-[38vh] lg:py-[18vh]">
      {stages.map((s, i) => (
        <li class="j-stage max-w-md scroll-mt-32" data-stage={i + 1}>
          <h3 class="text-2xl font-semibold sm:text-[1.75rem]">{s.title}</h3>
          <p class="mt-3 text-[17px] leading-relaxed text-muted-foreground">{s.body}</p>
          <a href={s.link.href} class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-medium text-primary underline-offset-4 hover:underline">{s.link.label} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  /* The record fills in per stage. Each block has an entry transition; stage-specific states below. */
  [data-journey] .j-block,
  [data-journey] .j-line,
  [data-journey] .j-stamp,
  [data-journey] .j-bigstamp {
    transition:
      opacity var(--duration-slow) var(--ease-smooth-out),
      transform var(--duration-slow) var(--ease-smooth-out),
      filter var(--duration-slow) var(--ease-smooth-out);
  }
  [data-journey] .j-block { opacity: 0.22; transform: translateY(6px); }
  [data-journey] .j-line { opacity: 0; transform: translateX(-4px); }
  [data-journey] .j-stamp { opacity: 0; transform: scale(0.4) rotate(-20deg); filter: blur(3px); }
  [data-journey] .j-bigstamp { opacity: 0; transform: scale(1.6) rotate(-14deg); filter: blur(6px); }

  [data-journey][data-stage="1"] [data-j="request"],
  [data-journey][data-stage="2"] [data-j="request"],
  [data-journey][data-stage="2"] [data-j="row"],
  [data-journey][data-stage="3"] [data-j="row"],
  [data-journey][data-stage="3"] [data-j="log"],
  [data-journey][data-stage="4"] [data-j="row"],
  [data-journey][data-stage="4"] [data-j="log"] { opacity: 1; transform: none; }
  [data-journey][data-stage="3"] [data-j="request"],
  [data-journey][data-stage="4"] [data-j="request"] { opacity: 0.5; }

  [data-journey][data-stage="3"] [data-j="l1"],
  [data-journey][data-stage="3"] [data-j="l2"],
  [data-journey][data-stage="3"] [data-j="l3"],
  [data-journey][data-stage="3"] [data-j="l4"],
  [data-journey][data-stage="4"] .j-line { opacity: 1; transform: none; }
  [data-journey][data-stage="3"] [data-j="l2"] { transition-delay: 120ms; }
  [data-journey][data-stage="3"] [data-j="l3"] { transition-delay: 240ms; }
  [data-journey][data-stage="3"] [data-j="l4"] { transition-delay: 360ms; }
  [data-journey][data-stage="4"] [data-j="l5"] { transition-delay: 120ms; }

  [data-journey][data-stage="3"] [data-j="d1"] .j-stamp,
  [data-journey][data-stage="3"] [data-j="d3"] .j-stamp,
  [data-journey][data-stage="4"] .j-stamp { opacity: 1; transform: none; filter: none; }
  [data-journey][data-stage="4"] .j-bigstamp { opacity: 0.9; transform: rotate(-10deg); filter: none; }
  [data-journey] .j-dstatus::after { content: "pending"; }
  [data-journey][data-stage="3"] [data-j="d1"] .j-dstatus::after,
  [data-journey][data-stage="3"] [data-j="d3"] .j-dstatus::after,
  [data-journey][data-stage="4"] .j-dstatus::after { content: "sent"; color: var(--success); }
  [data-journey][data-stage="3"] [data-j="d2"] .j-dstatus::after { content: "failed · retrying"; color: var(--warning); }
  [data-journey] .j-dstatus { font-size: 0; }
  [data-journey] .j-dstatus::after { font-size: 12.5px; }
  [data-journey] .j-status::after { content: "incoming"; }
  [data-journey][data-stage="2"] .j-status::after,
  [data-journey][data-stage="3"] .j-status::after { content: "received · 200 OK"; }
  [data-journey][data-stage="4"] .j-status::after { content: "received · 3/3 sent"; }
  [data-journey] .j-status { font-size: 0; }
  [data-journey] .j-status::after { font-size: 12px; }

  @media (prefers-reduced-motion: reduce) {
    [data-journey] .j-block, [data-journey] .j-line, [data-journey] .j-stamp, [data-journey] .j-bigstamp { transition: none; }
  }
  /* Without JS (or on narrow screens where the visual is not sticky) show the completed record. */
  .no-js [data-journey] .j-block, .no-js [data-journey] .j-line, .no-js [data-journey] .j-stamp { opacity: 1; transform: none; filter: none; }
</style>
<script>
  import { inView } from "motion"
  const root = document.querySelector<HTMLElement>("[data-journey]")
  if (root) {
    const stages = root.querySelectorAll<HTMLElement>("[data-stage]")
    const mq = window.matchMedia("(min-width: 1024px)")
    const set = (n: string) => root.setAttribute("data-stage", n)
    set("1")
    if (!mq.matches) {
      // Narrow screens: the visual sits above the text; show it complete.
      set("4")
    } else {
      stages.forEach((el) => {
        inView(el, () => { set(el.dataset.stage!) }, { margin: "-45% 0px -45% 0px" })
      })
    }
  }
</script>
