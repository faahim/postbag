---
import { EXAMPLE } from "@/config"

const stages = [
  { title: "Received", body: "The 2am message is kept the instant it lands. Even spam gets a label, not a trapdoor.", state: "HTTP 200" },
  { title: "Saved first", body: "Saved means saved — before we so much as think about emailing anyone.", state: "committed" },
  { title: "Routed second", body: "Sending comes second. A bad email day just means waiting, never vanishing.", state: "worker awake" },
  { title: "Kept on record", body: "Failed sends retry, again and again, with every attempt on the record. No mysteries.", state: "attempt 2 sent" },
] as const
---
<section class="container-x mt-28 sm:mt-40" aria-labelledby="journey-heading" id="journey" data-journey>
  <div class="mx-auto max-w-3xl text-center" data-reveal>
    <h2 id="journey-heading" class="text-4xl font-semibold sm:text-5xl">It lands before it travels.</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">Someone fills in your form at 2am on a Saturday. Your email is mid-outage. On Monday the message is in your inbox like nothing happened — because it was saved the moment it arrived.</p>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(19rem,0.72fr)] lg:gap-20">
    <div class="min-w-0 lg:sticky lg:top-24 lg:self-start" data-reveal>
      <figure class="journey-receipt overflow-hidden rounded-2xl bg-surface" aria-label="A message being saved first, then sent onward">
        <figcaption class="flex min-h-12 items-center justify-between gap-4 px-5 font-mono text-xs text-muted-foreground">
          <span>Submission <span class="text-foreground">{EXAMPLE.submission}</span></span>
          <span class="journey-state text-primary" data-journey-state>incoming</span>
        </figcaption>
        <div class="p-5 sm:p-7">
          <div class="arrival-track" aria-hidden="true">
            <span class="form-plane"><i></i><i></i><i></i></span>
            <span class="receiving-slot"></span>
          </div>
          <div class="mt-7 grid gap-4 font-mono text-xs sm:grid-cols-[1fr_auto_1fr] sm:items-center">
            <div class="journey-node" data-node="submission">
              <span class="text-muted-foreground">Submission</span>
              <strong class="mt-1 block font-medium text-foreground">status: received</strong>
            </div>
            <span class="route-thread" aria-hidden="true"></span>
            <div class="journey-node" data-node="delivery">
              <span class="text-muted-foreground">Delivery</span>
              <strong class="mt-1 block font-medium text-foreground" data-delivery-status>waiting for route</strong>
            </div>
          </div>
          <div class="mt-4 grid gap-2 font-mono text-[11px] text-muted-foreground sm:grid-cols-3">
            <span class="record-line" data-record="one">unique (form_id, idempotency_key)</span>
            <span class="record-line" data-record="two">unique (submission_id, route_id)</span>
            <span class="record-line" data-record="three">provider response retained</span>
          </div>
        </div>
      </figure>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/features/never-lose-a-submission/" class="font-medium text-primary underline-offset-4 hover:underline">Why save first matters</a>
        <a href="/docs/architecture/" class="font-medium text-primary underline-offset-4 hover:underline">Read the architecture</a>
      </div>
    </div>

    <ol class="grid gap-12 lg:gap-[24vh] lg:py-[8vh]">
      {stages.map((stage, index) => (
        <li class="journey-stage scroll-mt-32" data-stage={index + 1}>
          <p class="font-mono text-xs text-primary tabular-nums">{stage.state}</p>
          <h3 class="mt-3 text-3xl font-semibold">{stage.title}</h3>
          <p class="mt-3 text-[17px] leading-relaxed text-muted-foreground">{stage.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .journey-receipt { box-shadow: var(--shadow-xl), inset 0 0 0 1px var(--border); }
  .arrival-track { position: relative; display: grid; place-items: center; min-height: 12rem; overflow: hidden; border-radius: calc(var(--radius) + 8px); background: var(--surface-2); }
  .arrival-track::before { content: ""; position: absolute; inset: 0; opacity: .55; background: radial-gradient(circle at 50% 76%, color-mix(in oklch, var(--primary) 28%, transparent), transparent 38%); }
  .form-plane { position: relative; width: 7rem; height: 4.8rem; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-lg), inset 0 0 0 1px var(--border-strong); transform: translateY(-2.1rem) rotate(-4deg); transition-property: transform, opacity; transition-duration: var(--duration-slow); transition-timing-function: var(--ease-smooth-out); }
  .form-plane i { display: block; width: 62%; height: 2px; margin: 1rem 1.25rem -0.55rem; border-radius: 999px; background: var(--border-strong); }
  .receiving-slot { position: absolute; bottom: 2.2rem; width: min(78%, 21rem); height: 2.7rem; border-radius: 50%; background: var(--foreground); box-shadow: 0 -1px 0 var(--border-strong), 0 18px 30px color-mix(in oklch, var(--primary) 22%, transparent); transform: scaleY(.4); }
  .journey-node { min-height: 4.5rem; padding: 1rem; border-radius: var(--radius); background: var(--background); box-shadow: inset 0 0 0 1px var(--border); transition-property: opacity, transform, box-shadow; transition-duration: var(--duration-medium); transition-timing-function: var(--ease-smooth-out); }
  .route-thread { width: 3rem; height: 1px; background: var(--border-strong); transition-property: background-color, transform; transition-duration: var(--duration-medium); transition-timing-function: var(--ease-smooth-out); }
  .record-line { opacity: .38; transition-property: opacity; transition-duration: var(--duration-medium); transition-timing-function: var(--ease-smooth-out); }
  [data-journey][data-stage="1"] .form-plane { transform: translateY(-.7rem) rotate(-2deg); }
  [data-journey][data-stage="2"] .form-plane,
  [data-journey][data-stage="3"] .form-plane,
  [data-journey][data-stage="4"] .form-plane { transform: translateY(1.1rem) rotate(0deg) scale(.92); }
  [data-journey][data-stage="2"] [data-record="one"],
  [data-journey][data-stage="3"] [data-record="one"],
  [data-journey][data-stage="4"] .record-line { opacity: 1; }
  [data-journey][data-stage="3"] .route-thread,
  [data-journey][data-stage="4"] .route-thread { background: var(--primary); transform: scaleX(1.15); }
  [data-journey][data-stage="3"] [data-node="delivery"],
  [data-journey][data-stage="4"] [data-node="delivery"] { box-shadow: inset 0 0 0 1px var(--primary), var(--shadow-md); }
  @media (max-width: 639px) { .route-thread { width: 1px; height: 2rem; margin: -1rem auto; } }
  @media (prefers-reduced-motion: reduce) { .form-plane, .journey-node, .route-thread, .record-line { transition: none; } }
</style>

<script>
  import { inView } from "motion"
  const journey = document.querySelector<HTMLElement>("[data-journey]")
  if (journey) {
    const labels = ["incoming", "stored", "delivery pending", "attempt 2 sent"]
    const delivery = journey.querySelector<HTMLElement>("[data-delivery-status]")
    const state = journey.querySelector<HTMLElement>("[data-journey-state]")
    const setStage = (value: number) => {
      journey.dataset.stage = String(value)
      if (state) state.textContent = labels[value - 1] ?? labels[0]!
      if (delivery) delivery.textContent = value < 3 ? "waiting for worker" : value === 3 ? "retry scheduled" : "sent on attempt 2"
    }
    const media = window.matchMedia("(min-width: 1024px)")
    setStage(media.matches ? 1 : 4)
    if (media.matches) journey.querySelectorAll<HTMLElement>("[data-stage]").forEach((stage) => inView(stage, () => setStage(Number(stage.dataset.stage)), { margin: "-42% 0px -42% 0px" }))
  }
</script>
