---
import CodeBlock from "@/components/CodeBlock.astro"
import Postmark from "@/components/Postmark.astro"
import { Check } from "@lucide/astro"
import { API_URL, EXAMPLE } from "@/config"
const url = `${API_URL}/s/${EXAMPLE.form}`
const demoFormId = (import.meta.env.PUBLIC_DEMO_FORM_ID as string | undefined) ?? "fm_73c74vjq6z24"
const demoSubmitUrl = demoFormId ? `${API_URL}/s/${demoFormId}` : undefined
// These mirror apps/server/src/lib/snippets.ts, which renders the same snippets for a real form
// from GET /v1/forms/{id}/embed and the quickstart response.
const tabs = [
  { id: "html", label: "HTML", lang: "html", code: `<form action="${url}" method="POST">\n  <label>Email<input type="email" name="email" required /></label>\n  <label>Message<textarea name="message" required></textarea></label>\n  <button type="submit">Send</button>\n</form>` },
  { id: "fetch", label: "fetch", lang: "js", code: `await fetch("${url}", {\n  method: "POST",\n  headers: { "Content-Type": "application/json" },\n  body: JSON.stringify(data),\n})` },
  { id: "react", label: "React", lang: "jsx", code: `async function handleSubmit(event) {\n  event.preventDefault()\n  await fetch("${url}", { method: "POST", body: new FormData(event.currentTarget) })\n}\n\nexport function ContactForm() {\n  return (\n    <form onSubmit={handleSubmit}>\n      <input type="email" name="email" placeholder="Email" required />\n      <textarea name="message" placeholder="Message" required />\n      <button type="submit">Send</button>\n    </form>\n  )\n}` },
  { id: "next", label: "Next.js action", lang: "ts", code: `"use server"\n\nexport async function submitForm(formData: FormData) {\n  await fetch("${url}", { method: "POST", body: formData })\n}` },
  { id: "curl", label: "curl", lang: "bash", code: `curl -X POST ${url} \\\n  -H "Content-Type: application/json" \\\n  -d '{"email":"you@example.com","message":"Hello","_test":true}'\n\n# → {"ok":true,"submission_id":"${EXAMPLE.submission}","status":"received","deliveries":["dl_…"]}` },
] as const
---
<section class="container-x mt-8 sm:mt-12" aria-labelledby="integration-heading">
  <div class="max-w-xl" data-reveal>
    <h2 id="integration-heading" class="text-3xl font-semibold sm:text-4xl">That is the whole integration.</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
      One URL per form. It accepts <code class="font-mono text-[0.9em]">application/x-www-form-urlencoded</code>, <code class="font-mono text-[0.9em]">multipart/form-data</code> and JSON, with or without JavaScript. Plain HTML posts get a <code class="font-mono text-[0.9em]">303</code> back to your page.
    </p>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="min-w-0" data-reveal>
      {demoSubmitUrl ? (
        <form id="demo-form" class="card relative overflow-hidden p-0 shadow-lg" action={demoSubmitUrl} method="POST" novalidate>
          <div class="flex h-10 items-center justify-between border-b border-border px-4 font-mono text-[12px] text-muted-foreground">
            <span class="truncate"><span class="text-foreground">POST</span> {demoSubmitUrl.replace(/^https?:\/\//u, "")}</span>
            <span class="chip hidden sm:inline-flex">live</span>
          </div>
          <div class="grid gap-4 p-5">
            <label class="grid gap-1.5 text-sm font-medium">
              <span>Email</span>
              <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="h-11 rounded-md bg-background px-3 font-normal text-foreground shadow-[inset_0_0_0_1px_var(--border-strong)] outline-none transition-shadow duration-150 placeholder:text-muted-foreground/70 focus:shadow-[inset_0_0_0_1px_var(--primary),0_0_0_3px_var(--ring)]" />
            </label>
            <label class="grid gap-1.5 text-sm font-medium">
              <span>Message</span>
              <textarea name="message" required rows="3" placeholder="Say hello. This posts to a real Postbag form." class="resize-none rounded-md bg-background px-3 py-2.5 font-normal text-foreground shadow-[inset_0_0_0_1px_var(--border-strong)] outline-none transition-shadow duration-150 placeholder:text-muted-foreground/70 focus:shadow-[inset_0_0_0_1px_var(--primary),0_0_0_3px_var(--ring)]"></textarea>
            </label>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <input type="hidden" name="_test" value="true" />
            <input type="hidden" name="_redirect" value="/?sent=1#demo" />
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs text-muted-foreground">Sent with <code class="font-mono">_test: true</code>. Stored, not delivered anywhere.</p>
              <button type="submit" class="btn btn-primary btn-sm" data-demo-submit>
                <span data-label>Send</span>
              </button>
            </div>
          </div>
          <div id="demo-receipt" class="hidden border-t border-border bg-surface-2/60 p-5" aria-live="polite">
            <div class="flex items-start gap-4">
              <div class="demo-stamp shrink-0" data-stamp><Postmark status="sent" size={44} title="Received" /></div>
              <div class="min-w-0 flex-1">
                <p class="font-display text-lg font-semibold leading-tight">It arrived.</p>
                <p class="mt-1 text-sm text-muted-foreground">The API's response, verbatim:</p>
                <pre class="mt-2 overflow-x-auto rounded-md bg-background p-3 font-mono text-[12px] leading-relaxed hairline" data-response></pre>
              </div>
            </div>
          </div>
          <div id="demo-error" class="hidden border-t border-border p-5 text-sm text-muted-foreground" aria-live="polite"></div>
        </form>
      ) : (
        <div class="card p-6 shadow-lg">
          <p class="font-mono text-[12px] text-muted-foreground">index.html</p>
          <pre class="mt-3 overflow-x-auto font-mono text-[13px] leading-relaxed"><code>&lt;form action="{API_URL}/s/fm_8f3kq2" method="POST"&gt;
  &lt;input name="email" type="email" required&gt;
  &lt;textarea name="message"&gt;&lt;/textarea&gt;
  &lt;button&gt;Send&lt;/button&gt;
&lt;/form&gt;</code></pre>
        </div>
      )}
      <p class="mt-3 text-center text-xs text-muted-foreground">A real form on a real Postbag account. Rate-limited like every form.</p>
      <ul class="mt-6 space-y-3 text-[15px] text-muted-foreground">
        <li class="flex gap-3"><Check size={18} stroke-width={2} class="mt-[3px] shrink-0 text-primary" aria-hidden="true" /><span>No SDK required. A submit URL is the contract.</span></li>
        <li class="flex gap-3"><Check size={18} stroke-width={2} class="mt-[3px] shrink-0 text-primary" aria-hidden="true" /><span>Control fields start with an underscore: <code class="font-mono text-[0.9em]">_redirect</code>, <code class="font-mono text-[0.9em]">_gotcha</code>, <code class="font-mono text-[0.9em]">_test</code>, <code class="font-mono text-[0.9em]">_idempotency</code>.</span></li>
        <li class="flex gap-3"><Check size={18} stroke-width={2} class="mt-[3px] shrink-0 text-primary" aria-hidden="true" /><span>Snippets for every framework come back from the API itself, rendered for your form's fields.</span></li>
      </ul>
      <a href="/docs/submit-endpoint/" class="mt-6 inline-flex items-center gap-1.5 text-[15px] font-medium text-primary underline-offset-4 hover:underline">Submit endpoint reference <span aria-hidden="true">→</span></a>
    </div>
    <div class="min-w-0" data-reveal style="--reveal-delay: 120ms" data-snippet-tabs>
      <div class="flex flex-wrap gap-1 rounded-lg bg-surface-2 p-1" role="tablist" aria-label="Integration snippets">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${t.id}`} tabindex={i === 0 ? 0 : -1} data-tab={t.id}
            class="rounded-md px-3 py-1.5 text-sm text-muted-foreground transition-colors duration-150 aria-selected:bg-surface aria-selected:text-foreground aria-selected:shadow-sm hover:text-foreground">{t.label}</button>
        ))}
      </div>
      <div class="mt-3">
        {tabs.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} data-panel={t.id}>
            <CodeBlock code={t.code} lang={t.lang} title={t.id === "html" ? "index.html" : t.id === "react" ? "ContactForm.jsx" : t.id === "next" ? "actions.ts" : t.id === "curl" ? "terminal" : "submit.js"} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .demo-stamp { transform: rotate(-12deg) scale(1.6); opacity: 0; filter: blur(4px); }
  .demo-stamp[data-in] {
    transform: rotate(-8deg) scale(1);
    opacity: 1;
    filter: blur(0);
    transition: transform 420ms var(--ease-bounce), opacity 300ms var(--ease-smooth-out), filter 300ms var(--ease-smooth-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-stamp { transform: rotate(-8deg); opacity: 1; filter: none; }
    .demo-stamp[data-in] { transition: none; }
  }
</style>
<script>
  const form = document.getElementById("demo-form") as HTMLFormElement | null
  if (form) {
    const receipt = document.getElementById("demo-receipt")!
    const errorBox = document.getElementById("demo-error")!
    const out = form.querySelector<HTMLElement>("[data-response]")!
    const stamp = form.querySelector<HTMLElement>("[data-stamp]")!
    const btn = form.querySelector<HTMLButtonElement>("[data-demo-submit]")!
    const label = btn.querySelector<HTMLElement>("[data-label]")!
    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      if (!form.reportValidity()) return
      const data = new FormData(form)
      const body: Record<string, unknown> = {}
      data.forEach((v, k) => { if (k !== "_redirect") body[k] = v })
      body["_test"] = true
      btn.disabled = true
      label.textContent = "Sending"
      errorBox.classList.add("hidden")
      try {
        const res = await fetch(form.action, { method: "POST", headers: { "content-type": "application/json", accept: "application/json" }, body: JSON.stringify(body) })
        const text = await res.text()
        let pretty = text
        try { pretty = JSON.stringify(JSON.parse(text), null, 2) } catch {}
        if (res.ok) {
          out.textContent = pretty
          receipt.classList.remove("hidden")
          requestAnimationFrame(() => requestAnimationFrame(() => stamp.setAttribute("data-in", "")))
          label.textContent = "Sent"
        } else {
          errorBox.textContent = `The API answered ${res.status}. Every error carries code, message, hint and docs:\n${pretty}`
          errorBox.classList.remove("hidden")
          label.textContent = "Send"
          btn.disabled = false
        }
      } catch (err) {
        errorBox.textContent = "Could not reach the API from this browser. The form still works without JavaScript: it posts and redirects."
        errorBox.classList.remove("hidden")
        label.textContent = "Send"
        btn.disabled = false
      }
    })
  }
</script>
<script>
  // Scoped to [data-snippet-tabs]: AgentPromptSwitcher uses the same data-tab/data-panel hooks
  // for its own switcher elsewhere on this page, so this must not query the whole document.
  document.querySelectorAll<HTMLElement>("[data-snippet-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"))
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"))
    function select(id: string) {
      tabs.forEach((t) => { const on = t.dataset.tab === id; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1 })
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id })
    }
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t.dataset.tab!))
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          const next = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length]!
          next.focus(); select(next.dataset.tab!)
        }
      })
    })
  })
</script>
