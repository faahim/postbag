---
import CodeBlock from "@/components/CodeBlock.astro"
import { API_URL, EXAMPLE } from "@/config"

const url = `${API_URL}/s/${EXAMPLE.form}`
const demoFormId = (import.meta.env.PUBLIC_DEMO_FORM_ID as string | undefined) ?? "fm_73c74vjq6z24"
const demoSubmitUrl = demoFormId ? `${API_URL}/s/${demoFormId}` : undefined
const tabs = [
  { id: "html", label: "HTML", lang: "html", code: `<form action="${url}" method="POST">\n  <label>Email<input type="email" name="email" required /></label>\n  <label>Message<textarea name="message" required></textarea></label>\n  <button type="submit">Send</button>\n</form>` },
  { id: "fetch", label: "fetch", lang: "js", code: `await fetch("${url}", {\n  method: "POST",\n  headers: { "Content-Type": "application/json" },\n  body: JSON.stringify(data),\n})` },
  { id: "react", label: "React", lang: "jsx", code: `async function handleSubmit(event) {\n  event.preventDefault()\n  await fetch("${url}", { method: "POST", body: new FormData(event.currentTarget) })\n}\n\nexport function ContactForm() {\n  return (\n    <form onSubmit={handleSubmit}>\n      <input type="email" name="email" required />\n      <textarea name="message" required />\n      <button type="submit">Send</button>\n    </form>\n  )\n}` },
  { id: "next", label: "Next.js", lang: "ts", code: `"use server"\n\nexport async function submitForm(formData: FormData) {\n  await fetch("${url}", { method: "POST", body: formData })\n}` },
  { id: "curl", label: "curl", lang: "bash", code: `curl -X POST ${url} \\\n  -H "Content-Type: application/json" \\\n  -d '{"email":"you@example.com","message":"Hello","_test":true}'\n\n# {"ok":true,"submission_id":"${EXAMPLE.submission}",\n#  "status":"received","deliveries":[]}` },
] as const
---
<section class="hero-follow-on container-x pt-20 sm:pt-28" aria-labelledby="integration-heading" id="demo">
  <div class="integration-intro" data-reveal>
    <p class="font-mono text-xs font-semibold text-primary">One submit URL</p>
    <h2 id="integration-heading" class="mt-3 max-w-3xl text-4xl font-semibold sm:text-5xl">Your form already knows where to go.</h2>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">Point your form at one URL, done — whatever your site speaks. We never say "got it" until we have.</p>
  </div>

  <div class="mt-12 grid items-start gap-8 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:gap-14">
    <div class="min-w-0 lg:pt-10" data-reveal>
      {demoSubmitUrl ? (
        <form id="demo-form" class="receipt-form overflow-hidden rounded-2xl bg-surface" action={demoSubmitUrl} method="POST" novalidate>
          <div class="flex min-h-12 items-center justify-between gap-4 px-5 font-mono text-[12px] text-muted-foreground">
            <span class="truncate"><span class="font-semibold text-foreground">POST</span> {demoSubmitUrl.replace(/^https?:\/\//u, "")}</span>
            <span class="shrink-0 text-primary">live</span>
          </div>
          <div class="grid gap-5 px-5 py-6 sm:px-6">
            <label class="grid gap-2 text-sm font-medium">
              <span>Email</span>
              <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="h-12 rounded-lg bg-background px-4 font-normal text-foreground shadow-[inset_0_0_0_1px_var(--border-strong)] outline-none transition-shadow duration-(--duration-quick) placeholder:text-muted-foreground/70 focus:shadow-[inset_0_0_0_1px_var(--primary),0_0_0_3px_var(--ring)]" />
            </label>
            <label class="grid gap-2 text-sm font-medium">
              <span>Message</span>
              <textarea name="message" required rows="4" placeholder="Say hello. This goes to a real Postbag form." class="resize-none rounded-lg bg-background px-4 py-3 font-normal text-foreground shadow-[inset_0_0_0_1px_var(--border-strong)] outline-none transition-shadow duration-(--duration-quick) placeholder:text-muted-foreground/70 focus:shadow-[inset_0_0_0_1px_var(--primary),0_0_0_3px_var(--ring)]"></textarea>
            </label>
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <input type="hidden" name="_test" value="true" />
            <input type="hidden" name="_redirect" value="/?sent=1#demo" />
            <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-center">
              <p class="text-xs leading-relaxed text-muted-foreground"><code class="font-mono">_test: true</code> means we save your hello without emailing anyone.</p>
              <button type="submit" class="btn btn-primary btn-sm min-w-24" data-demo-submit><span data-label>Send</span></button>
            </div>
          </div>
          <div id="demo-receipt" class="receipt-result hidden px-5 py-6 sm:px-6" aria-live="polite">
            <div class="grid grid-cols-[auto_1fr] gap-4">
              <span class="receipt-plane" aria-hidden="true"></span>
              <div class="min-w-0">
                <p class="font-display text-xl font-semibold">Safely received.</p>
                <p class="mt-1 text-sm text-muted-foreground">Here's the actual receipt, straight from the API:</p>
                <pre class="mt-3 overflow-x-auto rounded-lg bg-background p-3 font-mono text-[12px] leading-relaxed shadow-[inset_0_0_0_1px_var(--border)]" data-response></pre>
              </div>
            </div>
          </div>
          <div id="demo-error" class="receipt-result hidden whitespace-pre-wrap px-5 py-6 text-sm text-muted-foreground sm:px-6" aria-live="polite"></div>
        </form>
      ) : (
        <div class="receipt-form rounded-2xl bg-surface p-6">
          <p class="font-mono text-[12px] text-muted-foreground">index.html</p>
          <pre class="mt-3 overflow-x-auto font-mono text-[13px] leading-relaxed"><code>&lt;form action="{API_URL}/s/fm_8f3kq2" method="POST"&gt;
  &lt;input name="email" type="email" required&gt;
  &lt;button&gt;Send&lt;/button&gt;
&lt;/form&gt;</code></pre>
        </div>
      )}
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">This is a real Postbag form, living its normal life. Go ahead, say hello.</p>
    </div>

    <div class="min-w-0" data-reveal style="--reveal-delay: var(--duration-quick)" data-snippet-tabs>
      <div class="mb-3 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <p class="font-display text-xl font-semibold">Use what your site already uses.</p>
          <p class="mt-1 text-sm text-muted-foreground">Ready-to-paste snippets, generated for your own form too.</p>
        </div>
        <a href="/docs/submit-endpoint/" class="text-sm font-medium text-primary underline-offset-4 hover:underline">Submit reference</a>
      </div>
      <div class="flex max-w-full gap-1 overflow-x-auto rounded-xl bg-surface-2 p-1" role="tablist" aria-label="Submit snippets">
        {tabs.map((tab, index) => (
          <button type="button" role="tab" id={`tab-${tab.id}`} aria-selected={index === 0 ? "true" : "false"} aria-controls={`panel-${tab.id}`} tabindex={index === 0 ? 0 : -1} data-tab={tab.id} class="min-h-10 shrink-0 rounded-lg px-3 text-sm text-muted-foreground transition-colors duration-(--duration-quick) aria-selected:bg-surface aria-selected:text-foreground aria-selected:shadow-sm hover:text-foreground">{tab.label}</button>
        ))}
      </div>
      <div class="mt-3">
        {tabs.map((tab, index) => (
          <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={index !== 0} data-panel={tab.id}>
            <CodeBlock code={tab.code} lang={tab.lang} title={tab.id === "html" ? "index.html" : tab.id === "react" ? "ContactForm.jsx" : tab.id === "next" ? "actions.ts" : tab.id === "curl" ? "terminal" : "submit.js"} />
          </div>
        ))}
      </div>
      <dl class="mt-7 grid gap-5 sm:grid-cols-3">
        <div><dt class="font-mono text-xs text-primary">HTML</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Plain forms work exactly as they are.</dd></div>
        <div><dt class="font-mono text-xs text-primary">JSON</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">fetch gets a receipt back, with an id to prove it.</dd></div>
        <div><dt class="font-mono text-xs text-primary">Redirect</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">No JavaScript? Visitors land right back on your page.</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero-follow-on { position: relative; isolation: isolate; }
  .hero-follow-on::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: clamp(8rem, 12vw, 11rem);
    pointer-events: none;
    transform: translateX(-50%);
    background: linear-gradient(
      to bottom,
      oklch(0.115 0.042 272),
      oklch(0.115 0.042 272 / 0.46) 30%,
      oklch(0.115 0.042 272 / 0.12) 58%,
      transparent 82%
    );
  }
  .integration-intro { padding-left: clamp(0rem, 7vw, 5rem); }
  .receipt-form { box-shadow: var(--shadow-xl), inset 0 0 0 1px var(--border); }
  .receipt-result { border-top: 1px solid var(--border); background: var(--surface-2); }
  .receipt-plane { width: 2.75rem; height: 3.4rem; border-radius: var(--radius); background: var(--surface); box-shadow: 0 10px 26px color-mix(in oklch, var(--primary) 16%, transparent), inset 0 0 0 1px var(--border-strong); transform: rotate(-5deg); }
  @media (max-width: 767px) { .integration-intro { padding-left: 0; } }
</style>

<script>
  const form = document.getElementById("demo-form") as HTMLFormElement | null
  if (form) {
    const receipt = document.getElementById("demo-receipt")!
    const errorBox = document.getElementById("demo-error")!
    const output = form.querySelector<HTMLElement>("[data-response]")!
    const button = form.querySelector<HTMLButtonElement>("[data-demo-submit]")!
    const label = button.querySelector<HTMLElement>("[data-label]")!
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      if (!form.reportValidity()) return
      const data = new FormData(form)
      const body: Record<string, unknown> = {}
      data.forEach((value, key) => { if (key !== "_redirect") body[key] = value })
      body["_test"] = true
      button.disabled = true
      label.textContent = "Sending"
      errorBox.classList.add("hidden")
      try {
        const response = await fetch(form.action, { method: "POST", headers: { "content-type": "application/json", accept: "application/json" }, body: JSON.stringify(body) })
        const text = await response.text()
        let pretty = text
        try { pretty = JSON.stringify(JSON.parse(text), null, 2) } catch {}
        if (response.ok) {
          output.textContent = pretty
          receipt.classList.remove("hidden")
          label.textContent = "Received"
        } else {
          errorBox.textContent = `The API answered ${response.status}. Every error includes code, message, hint and docs.\n${pretty}`
          errorBox.classList.remove("hidden")
          label.textContent = "Send"
          button.disabled = false
        }
      } catch {
        errorBox.textContent = "This browser could not reach the API. The same Form still works without JavaScript by posting and redirecting."
        errorBox.classList.remove("hidden")
        label.textContent = "Send"
        button.disabled = false
      }
    })
  }
</script>

<script>
  document.querySelectorAll<HTMLElement>("[data-snippet-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"))
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"))
    const select = (id: string) => {
      tabs.forEach((tab) => { const active = tab.dataset.tab === id; tab.setAttribute("aria-selected", String(active)); tab.tabIndex = active ? 0 : -1 })
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id })
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab.dataset.tab!))
      tab.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
          const next = tabs[(index + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length]!
          next.focus()
          select(next.dataset.tab!)
        }
      })
    })
  })
</script>
