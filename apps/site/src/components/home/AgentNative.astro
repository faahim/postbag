---
import CodeBlock from "@/components/CodeBlock.astro"
import { API_URL, LLMS_URL, OPENAPI_URL } from "@/config"

const sandboxFlow = `$ curl -X POST ${API_URL}/v1/public/sandboxes \
  -H "content-type: application/json" \
  -H "Idempotency-Key: <uuidv4>" \
  -d '{"name":"Contact","origin":"https://example.com"}'

{ "sandbox": { "id": "fm_…", "submit_url": "${API_URL}/s/fm_…", "expires_at": "2026-08-25T09:00:00Z" },
  "sandbox_token": "pbs_…", "embed": { "html": "<form …>" }, "next": [ … ] }

$ curl ${API_URL}/v1/public/sandboxes/fm_… \
  -H "Authorization: Sandbox pbs_…"
{ "submissions": [{ "status": "received", "test": true }] }`

const steps = [
  { n: "Read", body: "The agent reads llms.txt and learns the three anonymous calls, the fixed vocabulary and the exact limits." },
  { n: "Create", body: "POST /v1/public/sandboxes creates a 24-hour Form and returns its stable submit URL, ready-made embeds and a one-time sandbox capability." },
  { n: "Wire and test", body: "It puts the embed in the site, posts a test Submission and reads it back. The receipt is durable and inert: nothing is sent onward before claim." },
  { n: "Claim when ready", body: "Only then do you authenticate. Claiming keeps the same Form id and submit URL; the agent can add Destinations and Routes and verify a new Delivery." },
] as const
---
<section class="container-x mt-28 sm:mt-36" aria-labelledby="agents-heading" id="agents">
  <div class="max-w-2xl" data-reveal>
    <h2 id="agents-heading" class="text-3xl font-semibold text-balance sm:text-4xl">What the agent does with that prompt.</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
      No signup. No dashboard. Your agent can leave a working Form behind before you even make an account. You only step in if you want to keep it and send Submissions onward.
    </p>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-[0.55fr_0.45fr] lg:gap-16" data-reveal-group="80">
    <ol class="grid gap-8">
      {steps.map((s, i) => (
        <li class="flex gap-4" data-reveal>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent font-mono text-[13px] font-semibold text-accent-foreground tabular">{i + 1}</span>
          <div class="min-w-0 pt-0.5">
            <h3 class="font-display text-[17px] font-semibold">{s.n}</h3>
            <p class="mt-1 text-[15px] leading-relaxed text-muted-foreground">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="min-w-0" data-reveal style="--reveal-delay: 120ms">
      <CodeBlock code={sandboxFlow} lang="bash" title="anonymous create → prove receipt" dense />
    </div>
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal>
    <a href="/for-ai-agents/" class="btn btn-primary">How agents use Postbag</a>
    <a href={LLMS_URL} class="btn btn-secondary">llms.txt</a>
    <a href={OPENAPI_URL} class="btn btn-secondary">openapi.json</a>
    <a href={`${API_URL}/.well-known/skills/index.json`} class="btn btn-secondary">.well-known/skills/</a>
  </div>
</section>
