---
// Streams: many forms → one shape → one partner. The example is the real lead pipeline Postbag
// generalises (vending machine sites feeding one partner). Field names are illustrative.
const sources = [
  { form: "kontorsautomat-contact", fields: ["fullName", "Företag", "tel", "message"] },
  { form: "tcg-automat-contact", fields: ["name", "company", "phone", "msg"] },
  { form: "snackbar-lead", fields: ["contact", "org", "mobile", "body", "city"] },
]
const schema = ["name", "company", "phone", "message", "site"]
---
<section class="container-x mt-28 sm:mt-36" aria-labelledby="operator-heading" id="streams">
  <div class="max-w-2xl" data-reveal>
    <h2 id="operator-heading" class="text-3xl font-semibold sm:text-4xl">Fifteen sites. One shape. One partner.</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
      A <strong class="font-medium text-foreground">stream</strong> groups forms, by id or by tag, and gives them one versioned output schema. Each form carries a mapping from its own field names onto that shape. A route sends the stream to a destination, with a delivery window, a digest schedule, or both.
    </p>
  </div>

  <figure class="mt-12 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]" aria-label="Three forms with different field names mapped onto one stream schema and routed to a partner" data-reveal-group="80">
    <!-- Sources -->
    <div class="grid min-w-0 gap-3" data-reveal>
      {sources.map((s) => (
        <div class="card p-4">
          <p class="font-mono text-[12px] text-muted-foreground">form · {s.form}</p>
          <ul class="mt-2 flex flex-wrap gap-1.5">{s.fields.map((f) => <li class="chip">{f}</li>)}</ul>
        </div>
      ))}
      <p class="px-1 text-sm text-muted-foreground">…and twelve more, attached by <code class="font-mono text-[0.9em]">tag:vending</code>.</p>
    </div>
    <div class="hidden items-center lg:flex" aria-hidden="true" data-reveal>
      <svg width="56" height="120" viewBox="0 0 56 120" fill="none" class="text-border-strong"><path d="M2 20 C 28 20, 28 60, 54 60 M2 60 H54 M2 100 C 28 100, 28 60, 54 60" stroke="currentColor" stroke-width="1.5"/><circle cx="54" cy="60" r="3" fill="var(--primary)"/></svg>
    </div>
    <!-- Stream -->
    <div class="card flex min-w-0 flex-col p-5 shadow-md" data-reveal>
      <p class="font-mono text-[12px] text-muted-foreground">stream · vending-leads · schema v3</p>
      <ul class="mt-3 grid gap-2 font-mono text-[13px]">
        {schema.map((f) => (
          <li class="flex items-center justify-between rounded-md bg-background px-3 py-2 hairline"><span>{f}</span><span class="text-muted-foreground">{f === "site" ? "const" : "from"}</span></li>
        ))}
      </ul>
      <p class="mt-3 text-[13px] leading-relaxed text-muted-foreground">Unmapped form fields ride along under <code class="font-mono">extras</code>. An incomplete mapping is a 422 at attach time, never a surprise at delivery time.</p>
    </div>
    <div class="hidden items-center lg:flex" aria-hidden="true" data-reveal>
      <svg width="56" height="24" viewBox="0 0 56 24" fill="none" class="text-border-strong"><path d="M2 12 H50 M44 6 L50 12 L44 18" stroke="currentColor" stroke-width="1.5"/></svg>
    </div>
    <!-- Route -->
    <div class="grid min-w-0 content-start gap-3" data-reveal>
      <div class="card p-4">
        <p class="font-mono text-[12px] text-muted-foreground">route · instant</p>
        <p class="mt-1.5 font-medium">→ partner webhook</p>
        <p class="mt-1 font-mono text-[12px] text-muted-foreground">window 2026-09-01 → 2026-12-31<br/>exclude spam · exclude quarantined</p>
      </div>
      <div class="card p-4">
        <p class="font-mono text-[12px] text-muted-foreground">route · digest</p>
        <p class="mt-1.5 font-medium">→ ops@ email, daily</p>
        <p class="mt-1 font-mono text-[12px] text-muted-foreground">cron 0 8 * * * · Europe/Stockholm<br/>one delivery per period, unique by (route, period)</p>
      </div>
      <div class="card p-4">
        <p class="font-mono text-[12px] text-muted-foreground">route · instant</p>
        <p class="mt-1.5 font-medium">→ CRM webhook, signed</p>
        <p class="mt-1 font-mono text-[12px] text-muted-foreground">Postbag-Signature: t=…,v1=…</p>
      </div>
    </div>
  </figure>
  <p class="mt-6 max-w-2xl text-[15px] text-muted-foreground" data-reveal>Changing the stream schema is a deliberate act: it creates a new immutable version, emits <code class="font-mono text-[0.9em]">stream.schema.changed</code>, and re-validates every source mapping. Downstream systems subscribe; they are never surprised.</p>
  <a href="/features/routing/" class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-medium text-primary underline-offset-4 hover:underline" data-reveal>Routing, streams and mappings in depth <span aria-hidden="true">→</span></a>
</section>
