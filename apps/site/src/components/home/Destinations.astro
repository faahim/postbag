---
import CodeBlock from "@/components/CodeBlock.astro"
import { Mail, Send, Webhook } from "@lucide/astro"
import { DESTINATIONS, EXAMPLE } from "@/config"
const icons = { email: Mail, telegram: Send, webhook: Webhook } as const
const webhook = `POST https://crm.example.com/postbag
Content-Type: application/json
Postbag-Signature: t=1724200000,v1=<hmac-sha256>
Postbag-Delivery: ${EXAMPLE.delivery}
Postbag-Event: submission.received

{ "id": "${EXAMPLE.delivery}", "type": "submission.received",
  "schema_version": 3,
  "form": { "id": "${EXAMPLE.form}", "slug": "office-contact" },
  "data": { "name": "Maja Lind", "company": "Kontorsautomat AB" },
  "meta": {} }`
---
<section class="container-x mt-28 sm:mt-40" aria-labelledby="destinations-heading" id="destinations">
  <div class="max-w-3xl" data-reveal>
    <h2 id="destinations-heading" class="text-4xl font-semibold sm:text-6xl">Send it somewhere useful.</h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">Your inbox, Telegram, your CRM — set up once, used by every form. Always testable before it matters.</p>
  </div>

  <div class="destination-rail mt-12">
    {DESTINATIONS.map((destination) => {
      const Icon = icons[destination.id]
      return (
        <article class="destination-item" data-reveal>
          <span class="destination-icon"><Icon size={22} stroke-width={1.75} aria-hidden="true" /></span>
          <div>
            <h3 class="text-xl font-semibold">{destination.name}</h3>
            <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-muted-foreground">{destination.blurb}</p>
          </div>
        </article>
      )
    })}
  </div>

  <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(16rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16">
    <div class="lg:pt-8" data-reveal>
      <h3 class="text-3xl font-semibold">Webhooks reach everything else.</h3>
      <p class="mt-4 text-[17px] leading-relaxed text-muted-foreground">Add a secret and Postbag signs every attempt, so your endpoint can verify it. If your server naps, we try up to 10 times, then keep the Delivery clearly surfaced for you to retry when it wakes up.</p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/features/destinations/" class="font-medium text-primary underline-offset-4 hover:underline">More about destinations</a>
        <a href="/docs/webhooks/" class="font-medium text-primary underline-offset-4 hover:underline">Verify a signature</a>
      </div>
    </div>
    <div class="min-w-0" data-reveal style="--reveal-delay: var(--duration-quick)">
      <CodeBlock code={webhook} lang="http" title="a webhook signed with your secret" dense />
    </div>
  </div>
</section>

<style>
  .destination-rail { display: grid; border-top: 1px solid var(--border-strong); }
  .destination-item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem; padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
  .destination-icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: var(--radius); color: var(--primary); background: var(--accent); transition-property: transform, background-color; transition-duration: var(--duration-quick); transition-timing-function: var(--ease-smooth-out); }
  .destination-item:hover .destination-icon { transform: translateY(-2px); background: color-mix(in oklch, var(--accent) 72%, var(--primary)); }
  @media (min-width: 768px) { .destination-rail { grid-template-columns: repeat(3, 1fr); column-gap: 2.25rem; } }
  @media (prefers-reduced-motion: reduce) { .destination-icon { transition: none; } }
</style>
