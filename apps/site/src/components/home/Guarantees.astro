---
const invariants = [
  { sql: "unique (form_id, idempotency_key)", meaning: "Reusing an idempotency key cannot create a duplicate Submission." },
  { sql: "unique (submission_id, route_id)", meaning: "Each Route gets one Delivery record per Submission." },
  { sql: "unique (route_id, period_key)", meaning: "Each Route gets one digest record per period." },
  { sql: "unique (form_id, version)", meaning: "Old records are never quietly rewritten." },
  { sql: "organization_id not null", meaning: "Your data belongs to you, and the rules know it." },
] as const
---
<section class="container-x mt-28 sm:mt-40" aria-labelledby="guarantees-heading">
  <div class="guarantee-statement" data-reveal>
    <p class="font-mono text-xs font-semibold text-primary">No crossed fingers</p>
    <h2 id="guarantees-heading" class="mt-4 max-w-4xl text-4xl font-semibold sm:text-6xl">Promises you don't have to take our word for.</h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">Servers crash. Ours too — that's computers. Your messages are already safe when it happens.</p>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(16rem,0.65fr)_minmax(0,1.35fr)] lg:gap-20">
    <div class="grid content-start gap-8" data-reveal>
      <div>
        <h3 class="text-xl font-semibold">Never lose a message</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Spam, rate limits, odd traffic — everything that arrives is kept, with a label, until you delete it or its retention window ends.</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">No side doors</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">The dashboard, the CLI and your agent all go through the same front door. Anything you can click, an agent can do.</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">Yours means yours</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Every record belongs to your workspace, fenced twice over. No one else's account can so much as glance at it.</p>
      </div>
    </div>

    <div class="min-w-0" data-reveal>
      <ol class="invariant-ledger">
        {invariants.map((item) => (
          <li>
            <code>{item.sql}</code>
            <p>{item.meaning}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">Each line pairs a real database constraint with the practical promise it can actually keep.</p>
    </div>
  </div>
</section>

<style>
  .guarantee-statement { padding-left: clamp(0rem, 11vw, 8rem); }
  /* The exhibit panel is fixed deep ink in every theme — it must never flip light. */
  .invariant-ledger {
    overflow: hidden;
    border-radius: calc(var(--radius) + 12px);
    background: linear-gradient(165deg, oklch(0.18 0.05 272), oklch(0.115 0.045 272));
    color: oklch(0.95 0.018 278);
    box-shadow: var(--shadow-xl), inset 0 0 0 1px oklch(0.4 0.06 275 / 0.45);
  }
  .invariant-ledger li { display: grid; gap: .55rem; padding: 1.25rem 1.4rem; border-bottom: 1px solid oklch(1 0 0 / 0.07); }
  .invariant-ledger li:last-child { border-bottom: 0; }
  .invariant-ledger code { color: oklch(0.78 0.13 278); font-size: .78rem; }
  .invariant-ledger p { color: oklch(0.85 0.03 278); font-size: .92rem; line-height: 1.55; }
  @media (min-width: 640px) { .invariant-ledger li { grid-template-columns: minmax(13rem, .9fr) minmax(0, 1.1fr); align-items: baseline; gap: 2rem; } }
  @media (max-width: 767px) { .guarantee-statement { padding-left: 0; } }
</style>
