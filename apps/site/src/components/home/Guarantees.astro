---
const invariants = [
  { sql: "unique (form_id, idempotency_key)", meaning: "A retried POST never creates a second submission." },
  { sql: "unique (submission_id, route_id)", meaning: "One delivery per submission per route. No double sends." },
  { sql: "unique (route_id, period_key)", meaning: "One digest per period, however many workers run." },
  { sql: "unique (form_id, version) · rows never updated", meaning: "Schemas are immutable versions. Publish v2; v1 stays." },
  { sql: "organization_id not null · on every tenant row", meaning: "Every repository call is org-scoped. No cross-tenant query, ever." },
]
const rules = [
  { t: "Never lose a submission", b: "Spam, schema violations, rate limits, origin rejects and over-quota all store with a status. Deletion is only by your action or your retention policy." },
  { t: "Contract first", b: "The OpenAPI document is the truth. Dashboard, SDK and agents are clients of the same /v1. There is no UI-only capability." },
  { t: "Schemas are versions", b: "Form and stream schemas are immutable rows. Submissions and deliveries record the version they were validated against." },
  { t: "Self-host parity", b: "One image, one Postgres, one compose file. A feature that needs a cloud-only service with no self-host path does not ship." },
]
---
<section class="container-x mt-28 sm:mt-36" aria-labelledby="guarantees-heading">
  <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div data-reveal>
      <h2 id="guarantees-heading" class="text-3xl font-semibold sm:text-4xl">Correctness is carried by unique constraints, not by application logic.</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">These are the invariants Postgres enforces. Everything above them, the worker, the API, the dashboard, can crash mid-flight and the data still means what it says.</p>
      <dl class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-1" data-reveal-group="60">
        {rules.map((r) => (
          <div data-reveal>
            <dt class="font-display text-[17px] font-semibold">{r.t}</dt>
            <dd class="mt-1 text-[15px] leading-relaxed text-muted-foreground">{r.b}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="code-panel self-start p-0" data-reveal style="--reveal-delay: 120ms">
      <div class="flex h-10 items-center border-b border-border px-4 text-[12px] text-muted-foreground">postgres · invariants</div>
      <ol class="divide-y divide-border">
        {invariants.map((i) => (
          <li class="grid gap-1 px-4 py-3.5 sm:grid-cols-[1.1fr_1fr] sm:gap-6">
            <code class="text-[12.5px] text-foreground">{i.sql}</code>
            <span class="font-sans text-[14px] text-muted-foreground">{i.meaning}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
