---
const invariants = [
  { sql: "unique (form_id, idempotency_key)", meaning: "A retried POST cannot create a second Submission." },
  { sql: "unique (submission_id, route_id)", meaning: "One Delivery per Submission and Route. No double sends." },
  { sql: "unique (route_id, period_key)", meaning: "One digest per period, even with several workers." },
  { sql: "unique (form_id, version)", meaning: "Schemas are immutable versions. Publish the next one; keep the old one." },
  { sql: "organization_id not null", meaning: "Every tenant row belongs to an organization and every repository call is scoped." },
] as const
---
<section class="container-x mt-28 sm:mt-40" aria-labelledby="guarantees-heading">
  <div class="guarantee-statement" data-reveal>
    <p class="font-mono text-xs font-semibold text-primary">Correct by construction</p>
    <h2 id="guarantees-heading" class="mt-4 max-w-4xl text-4xl font-semibold sm:text-6xl">The promises live in Postgres, not in crossed fingers.</h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">Workers and APIs can stop halfway through a job. The data still means what it says when they come back.</p>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(16rem,0.65fr)_minmax(0,1.35fr)] lg:gap-20">
    <div class="grid content-start gap-8" data-reveal>
      <div>
        <h3 class="text-xl font-semibold">Never lose a Submission</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Spam, schema violations, rate limits, rejected origins and over-quota requests are stored with a status.</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">Contract first</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">The dashboard, SDK, CLI, MCP server and agents all use the same public API.</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">Scoped by organization</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">Tenant scope is required in repositories, with row-level security as a second fence.</p>
      </div>
    </div>

    <ol class="invariant-ledger" data-reveal>
      {invariants.map((item) => (
        <li>
          <code>{item.sql}</code>
          <p>{item.meaning}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .guarantee-statement { padding-left: clamp(0rem, 11vw, 8rem); }
  .invariant-ledger { overflow: hidden; border-radius: calc(var(--radius) + 12px); background: var(--foreground); color: var(--background); box-shadow: var(--shadow-xl); }
  .invariant-ledger li { display: grid; gap: .55rem; padding: 1.25rem 1.4rem; border-bottom: 1px solid color-mix(in oklch, var(--background) 14%, transparent); }
  .invariant-ledger li:last-child { border-bottom: 0; }
  .invariant-ledger code { color: color-mix(in oklch, var(--primary) 72%, var(--background)); font-size: .78rem; }
  .invariant-ledger p { color: color-mix(in oklch, var(--background) 72%, var(--foreground)); font-size: .92rem; line-height: 1.55; }
  @media (min-width: 640px) { .invariant-ledger li { grid-template-columns: minmax(13rem, .9fr) minmax(0, 1.1fr); align-items: baseline; gap: 2rem; } }
  @media (max-width: 767px) { .guarantee-statement { padding-left: 0; } }
</style>
