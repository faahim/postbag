---
import AgentPromptSwitcher from "@/components/AgentPromptSwitcher.astro"
import { SIGNUP_URL } from "@/config"
---
<section class="container-x pt-14 pb-16 sm:pt-20 lg:pt-24 lg:pb-24">
  <div class="mx-auto max-w-[42rem] text-center" data-reveal-group="90">
    <h1 class="display-tight text-[2.75rem] font-semibold leading-[1.02] sm:text-6xl" data-reveal>
      A form backend that <em class="not-italic text-primary">routes</em>.
    </h1>
    <p class="mx-auto mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground sm:text-xl" data-reveal>
      Paste one line into your coding agent and your site has a working, routed contact form. No dashboard, no human in the loop.
    </p>
  </div>

  <div class="mx-auto mt-10 max-w-2xl" data-reveal style="--reveal-delay: 120ms">
    <AgentPromptSwitcher />
  </div>

  <div class="mx-auto mt-7 flex max-w-2xl flex-col items-center gap-3 text-center" data-reveal style="--reveal-delay: 180ms">
    <a href={`${SIGNUP_URL}`} class="btn btn-secondary">Or create a form by hand</a>
    <p class="text-xs text-muted-foreground">Submissions are stored the instant they land, never dropped, and delivered in under three minutes.</p>
  </div>
</section>
