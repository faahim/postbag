---
import AgentPromptSwitcher from "@/components/AgentPromptSwitcher.astro"
---
<section class="hero-shell" data-hero>
  <div class="hero-scene" data-hero-asset aria-hidden="true" data-reveal>
    <picture>
      <source media="(max-width: 767px)" srcset="/brand/hero-receiving-pocket-mobile-v5.webp" width="941" height="1672" />
      <img
        src="/brand/hero-receiving-pocket-desktop-v5.webp"
        width="1672"
        height="941"
        alt=""
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div class="container-x hero-message" data-reveal-group="90">
    <div class="hero-copy">
      <p class="hero-kicker" data-reveal>Open source. Agent-native. Yours.</p>
      <h1 class="display-tight hero-title" data-reveal>Your forms have somewhere to go.</h1>
    </div>
    <div class="hero-intro">
      <p class="hero-lede" data-reveal>
        Your agent can create, wire and test a working Form. No signup. No dashboard. Claim it when you want to keep it and send submissions onward.
      </p>
      <div class="hero-actions" data-reveal style="--reveal-delay: 120ms">
        <a href="#agent-prompt" class="btn btn-primary">Give this to your agent</a>
        <a href="/docs/self-hosting/" class="btn hero-secondary-action">Self-host Postbag</a>
      </div>
    </div>
  </div>
</section>

<section class="hero-handoff" aria-labelledby="hero-handoff-heading">
  <div class="container-x">
    <div class="hero-handoff-panel" data-reveal>
      <div class="hero-handoff-heading">
        <p class="hero-handoff-kicker">One line. Then you can go do something else.</p>
        <h2 id="hero-handoff-heading">Give the job to your agent.</h2>
      </div>
      <div id="agent-prompt" class="hero-prompt">
        <AgentPromptSwitcher class="hero-agent-prompt" />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((hero) => {
    const asset = hero.querySelector<HTMLElement>("[data-hero-asset]")
    let reset: ReturnType<typeof setTimeout> | undefined
    document.addEventListener("postbag:codecopied", () => {
      if (!asset) return
      clearTimeout(reset)
      asset.removeAttribute("data-copy-pulse")
      void asset.offsetWidth
      asset.setAttribute("data-copy-pulse", "")
      reset = setTimeout(() => asset.removeAttribute("data-copy-pulse"), 2500)
    })
  })
</script>
