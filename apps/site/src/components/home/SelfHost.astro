---
import CodeBlock from "@/components/CodeBlock.astro"
import { GITHUB_URL } from "@/config"

const compose = `services:
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: postbag
      POSTGRES_USER: postbag
      POSTGRES_PASSWORD: change-me
    volumes: [ "postbag-postgres:/var/lib/postgresql/data" ]
  postbag:
    build: .
    depends_on: [ db ]
    environment:
      DATABASE_URL: postgres://postbag:change-me@db:5432/postbag
      APP_URL: https://forms.example.com
      BETTER_AUTH_SECRET: change-me-too
      POSTBAG_ROLE: all
      MIGRATE_ON_BOOT: "true"
    ports: [ "3000:3000" ]
volumes: { postbag-postgres: {} }`
---
<section class="ownership-wrap mt-28 sm:mt-40" aria-labelledby="selfhost-heading" id="self-host">
  <div class="container-x py-20 sm:py-28">
    <div class="max-w-4xl" data-reveal>
      <h2 id="selfhost-heading" class="text-4xl font-semibold sm:text-6xl">Run it here. Or run it yourself.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">Two doors into the same product — truly the same, not a generous demo. Cloud just means the server chores are ours.</p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(16rem,0.72fr)_minmax(0,1.28fr)] lg:gap-20">
      <div class="grid gap-10" data-reveal>
        <article class="ownership-path">
          <p class="font-mono text-xs font-semibold text-primary">Postbag Cloud</p>
          <h3 class="mt-3 text-2xl font-semibold">We keep it running.</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">Hosting, upgrades, backups, email plumbing — handled. Every plan gets the whole product; you pay for room, not features.</p>
          <a href="/pricing/" class="mt-5 inline-flex text-sm font-medium text-primary underline-offset-4 hover:underline">See Cloud pricing</a>
        </article>
        <article class="ownership-path">
          <p class="font-mono text-xs font-semibold text-primary">Self-host</p>
          <h3 class="mt-3 text-2xl font-semibold">You keep the keys.</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">One container, one database, everything included. There is no smaller "community edition" — this is the edition.</p>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <a href="/docs/self-hosting/" class="font-medium text-primary underline-offset-4 hover:underline">Self-host guide</a>
            <a href={GITHUB_URL} class="font-medium text-primary underline-offset-4 hover:underline">Read the source</a>
          </div>
        </article>
      </div>

      <div class="min-w-0" data-reveal style="--reveal-delay: var(--duration-quick)">
        <CodeBlock code={compose} lang="yaml" title="docker-compose.yml" dense />
        <dl class="mt-6 grid gap-5 sm:grid-cols-3">
          <div><dt class="font-mono text-xs text-primary">One image</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Run the API, worker or both.</dd></div>
          <div><dt class="font-mono text-xs text-primary">One database</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">Postgres is the only stateful dependency.</dd></div>
          <div><dt class="font-mono text-xs text-primary">Open source</dt><dd class="mt-2 text-sm leading-relaxed text-muted-foreground">AGPL service. MIT SDK, CLI and MCP server.</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .ownership-wrap { position: relative; overflow: hidden; background: var(--surface-2); box-shadow: inset 0 1px 0 var(--border); }
  .ownership-wrap::after { content: ""; position: absolute; right: -10rem; bottom: -16rem; width: 34rem; height: 34rem; border-radius: 50%; pointer-events: none; background: radial-gradient(circle, color-mix(in oklch, var(--primary) 20%, transparent), transparent 66%); }
  .ownership-path { padding-bottom: 2rem; border-bottom: 1px solid var(--border-strong); }
  .ownership-path:last-child { padding-bottom: 0; border-bottom: 0; }
</style>
