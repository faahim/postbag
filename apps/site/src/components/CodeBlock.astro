---
import { Code } from "astro:components"
import type { ComponentProps } from "astro/types"
type CodeLang = NonNullable<ComponentProps<typeof Code>["lang"]>
interface Props { code: string; lang?: CodeLang | string; title?: string; class?: string; copy?: boolean; dense?: boolean }
const { code, lang = "text", title, class: className = "", copy = true, dense = false } = Astro.props
---
<figure class={`code-panel overflow-hidden ${className}`} data-codeblock>
  {(title || copy) && (
    <figcaption class="flex h-10 items-center justify-between gap-3 border-b border-border px-4">
      <span class="truncate font-mono text-[12px] text-muted-foreground">{title}</span>
      {copy && (
        <button type="button" class="copy-btn relative -mr-1.5 inline-flex h-8 items-center gap-1.5 rounded-md px-2 font-sans text-xs text-muted-foreground transition-colors duration-150 hover:bg-surface-2 hover:text-foreground" data-copy aria-label="Copy code">
          <span class="copy-label">Copy</span>
          <span class="copied-label absolute inset-0 hidden items-center justify-center text-success">Copied</span>
        </button>
      )}
    </figcaption>
  )}
  <div class={`overflow-x-auto ${dense ? "p-3 text-[12.5px]" : "p-4"}`}>
    <Code code={code} lang={lang as CodeLang} themes={{ light: "github-light", dark: "github-dark-dimmed" }} wrap={false} />
  </div>
  <pre class="hidden" data-raw>{code}</pre>
</figure>
<script>
  document.querySelectorAll<HTMLElement>("[data-codeblock]").forEach((block) => {
    const btn = block.querySelector<HTMLButtonElement>("[data-copy]")
    const raw = block.querySelector<HTMLElement>("[data-raw]")?.textContent ?? ""
    btn?.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(raw) } catch { return }
      btn.querySelector(".copy-label")?.classList.add("invisible")
      const done = btn.querySelector<HTMLElement>(".copied-label")
      done?.classList.remove("hidden"); done?.classList.add("inline-flex")
      setTimeout(() => { btn.querySelector(".copy-label")?.classList.remove("invisible"); done?.classList.add("hidden"); done?.classList.remove("inline-flex") }, 1400)
    })
  })
</script>
