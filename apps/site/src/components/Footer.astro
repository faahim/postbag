---
import { API_URL, GITHUB_URL, LLMS_URL, OPENAPI_URL, SIGNUP_URL } from "@/config"

const cols = [
  {
    title: "Product",
    links: [
      { href: "/features/", label: "Features" },
      { href: "/features/routing/", label: "Routing and Streams" },
      { href: "/features/destinations/", label: "Destinations" },
      { href: "/features/schemas-and-drift/", label: "Schemas and Drift" },
      { href: "/pricing/", label: "Pricing" },
    ],
  },
  {
    title: "Build",
    links: [
      { href: "/docs/quickstart/", label: "Quickstart" },
      { href: "/docs/agents/", label: "Agent guide" },
      { href: "/docs/submit-endpoint/", label: "Submit URL" },
      { href: "/docs/self-hosting/", label: "Self-hosting" },
      { href: "/docs/api/", label: "API reference" },
    ],
  },
  {
    title: "Explore",
    links: [
      { href: "/compare/", label: "Compare" },
      { href: "/use-cases/", label: "Use cases" },
      { href: "/changelog/", label: "Changelog" },
      { href: "/glossary/", label: "Glossary" },
      { href: "/about/", label: "About" },
    ],
  },
  {
    title: "For agents",
    links: [
      { href: "/for-ai-agents/", label: "Agent-native overview" },
      { href: LLMS_URL, label: "llms.txt" },
      { href: "/llms-full.txt", label: "llms-full.txt" },
      { href: OPENAPI_URL, label: "OpenAPI" },
      { href: GITHUB_URL, label: "GitHub" },
    ],
  },
]
const year = new Date().getFullYear()
---
<footer class="brand-ink-canvas relative mt-24 overflow-hidden bg-brand-ink text-brand-form">
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-indigo/45 via-transparent to-brand-periwinkle/10" aria-hidden="true"></div>
  <div class="container-x relative py-16 sm:py-20">
    <div class="grid gap-14 border-b border-brand-form/10 pb-14 lg:grid-cols-[1.25fr_2fr] lg:gap-20">
      <div class="max-w-lg">
        <a href="/" class="flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight">
          <img src="/logo-mark-455264e.svg" alt="" width="28" height="28" class="size-7 shrink-0" loading="lazy" />
          Postbag
        </a>
        <p class="mt-6 font-display text-3xl font-semibold leading-tight text-brand-form sm:text-4xl">Somewhere to go. Somewhere that is yours.</p>
        <p class="mt-5 max-w-md text-base leading-relaxed text-brand-muted">The open-source form backend built for agents. Use Postbag Cloud, or run the same product yourself.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={SIGNUP_URL} class="btn btn-primary btn-sm">Create a Form</a>
          <a href="/docs/self-hosting/" class="btn btn-sm bg-brand-form/10 text-brand-form hover:bg-brand-form/15">Self-host Postbag</a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {cols.map((col) => (
          <div>
            <h2 class="font-sans text-[13px] font-semibold text-brand-form">{col.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li><a href={link.href} class="text-sm text-brand-muted transition-colors duration-(--duration-quick) hover:text-brand-form">{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-4 pt-6 text-xs text-brand-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Postbag. Built by <a href="https://faahim.dev" class="underline-offset-2 hover:underline">Fahim</a>.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        <li><a href={`${API_URL}/health`} class="hover:text-brand-form">API status</a></li>
        <li><a href="/sitemap-index.xml" class="hover:text-brand-form">Sitemap</a></li>
        <li><a href="/legal/privacy/" class="hover:text-brand-form">Privacy</a></li>
        <li><a href="/legal/terms/" class="hover:text-brand-form">Terms</a></li>
        <li><a href="/legal/dpa/" class="hover:text-brand-form">DPA</a></li>
      </ul>
    </div>
  </div>
</footer>
